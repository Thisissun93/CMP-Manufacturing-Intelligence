:'not loaded'}</div>`).join('');msg(`${Object.keys(tables).length}/6 역할 파일 준비`)}\nfunction legacyRows(name,p){const out=[],r=p.rows,h=p.headers,has=x=>h.includes(x);if(name==='Batch'&&has('Product_ID'))for(const x of r)out.push({Batch_ID:x.Batch_ID,Product_ID:x.Product_ID,Recipe_Rev:x.Recipe_Rev||'UNKNOWN',Site_ID:'SITE',Line_ID:'LINE-01',Equipment_ID:x.Equipment_ID,Start_TS:x.Start_TS,End_TS:x.End_TS,Disposition:x.Disposition||'HOLD',Data_Origin:x.Data_Origin||'ACTUAL'});else if(name==='Material'&&has('Silica_Lot_ID'))for(const x of r)out.push({Material_Record_ID:x.Material_Record_ID,Batch_ID:x.Batch_ID,Material_ID:'SILICA',Lot_ID:x.Silica_Lot_ID,Quantity:x.Silica_Charge_kg,Unit:'kg',Charge_TS:x.Charge_Start_TS,Data_Origin:x.Data_Origin||'ACTUAL'});else if(name==='Process'&&has('Mix_Temp_Mean_C'))for(const x of r){out.push({Process_Record_ID:x.Process_Record_ID+'-TEMP',Batch_ID:x.Batch_ID,Step_Run_ID:x.Process_Record_ID,Step_ID:'MIX',Equipment_ID:x.Equipment_ID,Parameter:'Temperature',Value:x.Mix_Temp_Mean_C,Unit:'C',Event_TS:x.Mix_Start_TS,Step_Start_TS:x.Mix_Start_TS,Step_End_TS:x.Mix_End_TS,Data_Origin:x.Data_Origin||'ACTUAL'});out.push({Process_Record_ID:x.Process_Record_ID+'-DP',Batch_ID:x.Batch_ID,Step_Run_ID:x.Process_Record_ID,Step_ID:'FILTER',Equipment_ID:x.Equipment_ID,Parameter:'Filter_DP',Value:x.Filter_DP_Max_kPa,Unit:'kPa',Event_TS:x.Filter_End_TS,Step_Start_TS:x.Filter_Start_TS,Step_End_TS:x.Filter_End_TS,Data_Origin:x.Data_Origin||'ACTUAL'});}else if(name==='Equipment'&&has('Snapshot_TS'))for(const x of r)out.push({Equipment_Event_ID:x.Equipment_Record_ID,Equipment_ID:x.Equipment_ID,Event_Type:'STATUS',Valid_From_TS:x.Snapshot_TS,Valid_To_TS:x.Snapshot_TS.replace(/T\\d{2}:\\d{2}:\\d{2}/,'T23:59:59'),Result:'OK',Data_Origin:x.Data_Origin||'ACTUAL'});else if(name==='QC'&&has('pH_25C'))for(const x of r)for(const [id,v] of Object.entries({pH:x.pH_25C,Solids:x.Solids_wt_pct,Viscosity:x.Viscosity_mPa_s,D50:x.PSD_D50_nm,D90:x.PSD_D90_nm,LPC_0p5:x.LPC_gt_0p5um_count_mL,LPC_1p0:x.LPC_gt_1p0um_count_mL,Zeta:x.Zeta_mV,Fe:x.Fe_ug_kg}))out.push({QC_Record_ID:x.QC_Record_ID+'-'+id,Batch_ID:x.Batch_ID,Sample_ID:x.Sample_ID,Analyte_ID:id,Value:v,Unit:'unit',Method_ID:x.Method_Set_ID||'UNKNOWN',Spec_Rev:x.Spec_Rev||'UNSPECIFIED',LSL:'',USL:'',Qualifier:v===''?'NOT_MEASURED':'EQ',Sample_TS:x.Sample_TS,Result_TS:x.Result_TS,Is_Final:'true',Approval_Status:'APPROVED',Spec_Status:'UNSPECIFIED',Data_Origin:x.Data_Origin||'ACTUAL'});else if(name==='Checksheet'&&has('Prestart_TS'))for(const x of r)out.push({Checksheet_Record_ID:x.Checksheet_Record_ID,Scope_Type:'SITE',Scope_ID:'SITE',Checklist_Type:'SHIFT_PRESTART',Valid_From_TS:x.Prestart_TS.slice(0,11)+'00:00:00+09:00',Valid_To_TS:x.Prestart_TS.slice(0,11)+'23:59:59+09:00',Completed_TS:x.Prestart_TS,Result:x.Line_Clearance==='PASS'?'PASS':'FAIL',Comment:x.Comment||'',Data_Origin:x.Data_Origin||'ACTUAL'});if(!out.length)throw Error(`${name}.csv: 역할을 식별할 수 없습니다.`);return out;}\nasync function load(files){try{for(const f of files){const raw=new TextDecoder('utf-8',{fatal:true}).decode(await f.arrayBuffer()),p=V2.parseCSV(raw);let k,rows;try{k=V2.classify(schema,p.headers);rows=p.rows}catch(_){k=['Batch','Material','Process','Equipment','QC','Checksheet'].find(n=>{try{return legacyRows(n,p).length>0}catch(e){return false}});if(!k)throw Error(`${f.name}: v1/v2 필수 열을 확인하세요.`);rows=legacyRows(k,p);msg('v1 요약 CSV를 v2 상세 기록으로 자동 변환 중...');}if(tables[k])throw Error(`${k} 역할 파일이 이미 있습니다.`);const h=schema[k].map(x=>x.name),text=[h,...rows.map(x=>h.map(z=>x[z]))].map(x=>x.map(v=>'\"'+String(v??'').replaceAll('\"','\"\"')+'\"').join(',')).join('\\n');tables[k]=V2.readTable(k,text,schema,`${f.name} (호환 변환)`);}refresh();msg('파일을 불러왔습니다. v1 형식은 자동 변환되었습니다.')}catch(e){msg(e.message,'bad')}}\n$('#pick').onclick=()=>$('#files').click();$('#files').onchange=e=>load([...e.target.files]);$('#drop').ondragover=e=>e.preventDefault();$('#drop').ondrop=e=>{e.preventDefault();load([...e.dataTransfer.files])};$('#clear').onclick=()=>{tables={};$('#out').innerHTML='';refresh()};\nfunction ensure(){if(Object.keys(tables).length<6)throw Error('6개 역할 파일을 모두 넣어주세요. 파일 수가 적은 것이 아니라 역할 파일이 빠진 것입니다.')}function show(r){const fs=r.findings;$('#out').innerHTML=`<section><h2>${esc(r.bid)} 보고서</h2><p class=\"muted\">공장 전체 Checksheet 적용 · 관련 체크시트 ${r.check.required.length}건 · 이 Batch와 시간상 겹치는 Batch 참조 ${r.shared[0]?.batchCount||0}건</p>${fs.length?fs.map(f=>`<div class=\"finding\"><span class=\"pill ${f.kind==='oos'||f.kind==='integrity'?'bad':f.kind==='missing'?'warn':''}\">${esc(f.kind)}</span><b>${esc(f.title)}</b><br><span class=\"muted\">${esc(f.detail)} ${f.sources?.length?'['+f.sources.map(esc).join('; ')+']':''}</span></div>`).join(''):'<p class=\"ok\">추가 신호 없음</p>'}<h3>QC 항목</h3><table><tr><th>Analyte</th><th>최종 상태</th><th>기록 수</th></tr>${r.qc.map(x=>`<tr><td>${esc(x.id)}</td><td>${esc(x.state)}</td><td>${x.rows.length}</td></tr>`).join('')}</table></section>`}\n$('#report').onclick=()=>{try{ensure();const r=V2.investigate(tables,$('#bid').value.trim(),{scope:'SITE',type:'SHIFT_PRESTART',provenance:{Checksheet:{from:$('#from').value?$('#from').value+'T00:00:00+09:00':null,to:$('#to').value?$('#to').value+'T23:59:59+09:00':null,basis:'engineer date filter'}}});show(r)}catch(e){msg(e.message,'bad')}};\n$('#scan').onclick=()=>{try{ensure();const from=$('#from').value,to=$('#to').value,bs=V2.filterBatches(tables.Batch.rows,from,to),out=[];for(const b of bs){const r=V2.investigate(tables,b.Batch_ID,{scope:'SITE',type:'SHIFT_PRESTART',provenance:{Checksheet:{from:from?from+'T00:00:00+09:00':null,to:to?to+'T23:59:59+09:00':null,basis:'engineer date filter'}}});if(r.findings.length)out.push(r)}$('#out').innerHTML=`<section><h2>날짜 범위 이상 Batch</h2><p class=\"muted\">${from||'전체'} ~ ${to||'전체'} · ${out.length}개</p>${out.map(r=>`<div class=\"finding\"><b>${esc(r.bid)}</b> · ${r.findings.map(f=>esc(f.title)).join(', ')}</div>`).join('')||'<p>조건에 맞는 신호가 없습니다.</p>'}</section>`}catch(e){msg(e.message,'bad')}};\n$('#demo').onclick=()=>{try{tables={};for(const[k,v]of Object.entries(sample))tables[k]=V2.readTable(k,v,schema,k+'.csv');refresh();$('#bid').value='B01';msg('v2 시연 데이터 준비 완료')}catch(e){msg(e.message,'bad')}};const oldRefresh=refresh;refresh=function(){$('#filesOut').innerHTML=V2.kinds.map(k=>`<div class=\"file ${tables[k]?'ok':''}\">${k}.csv · ${tables[k]?(tables[k]._sourceCount?tables[k].rows.length+' detail records · '+tables[k]._sourceCount+' source rows':tables[k].rows.length+' records'):'not loaded'}</div>`).join('');msg(`${Object.keys(tables).length}/6 역할 파일 준비`)};refresh();\n\n/* Shared reporting for summary and detail imports. */\nconst originalSchema=LEGACY_SCHEMA.fields;\nlet legacyTables={},lastResult=null;\nconst number=v=>v===''||v==null?null:Number(v);\nconst display=v=>v==null?'—':typeof v==='number'?v.toLocaleString('ko-KR',{maximumFractionDigits:3}):esc(v);\nfunction grid(headers,rows){return '<div class=\"scroll\"><table><thead><tr>'+headers.map(h=>'<th>'+esc(h)+'</th>').join('')+'</tr></thead><tbody>'+rows.map(row=>'<tr>'+row.map(v=>'<td>'+display(v)+'</td>').join('')+'</tr>').join('')+'</tbody></table></div>';}\nfunction statistics(points,value){const n=points.length,mean=n?points.reduce((s,p)=>s+p.value,0)/n:null,sd=n>1?Math.sqrt(points.reduce((s,p)=>s+(p.value-mean)**2,0)/(n-1)):null;return{n,mean,sd,delta:value!=null&&mean!=null?value-mean:null,z:value!=null&&sd>0?(value-mean)/sd:null};}\nfunction trend(m){const pts=m.points.concat(m.value==null?[]:[{id:lastResult.bid,value:m.value,current:true}]);if(!pts.length)return '<p>측정값 없음</p>';const values=pts.map(p=>p.value).concat(m.mean==null?[]:[m.mean]),lo=Math.min(...values),hi=Math.max(...values),pad=(hi-lo)*.15||1,y=v=>130-(v-lo+pad)/(hi-lo+2*pad)*110,x=i=>35+i*510/Math.max(1,pts.length-1);return '<svg viewBox=\"0 0 580 160\" role=\"img\" aria-label=\"'+esc(m.label)+' 과거 기준군과 선택 Batch 경향\"><text x=\"0\" y=\"15\" font-size=\"11\">'+display(hi)+'</text><text x=\"0\" y=\"145\" font-size=\"11\">'+display(lo)+'</text>'+(m.mean==null?'':'<path d=\"M35 '+y(m.mean)+' H550\" stroke=\"#8196a4\" stroke-dasharray=\"5 4\"/>')+'<polyline fill=\"none\" stroke=\"#0a8079\" stroke-width=\"2\" points=\"'+pts.map((p,i)=>x(i)+','+y(p.value)).join(' ')+'\"/>'+pts.map((p,i)=>'<circle cx=\"'+x(i)+'\" cy=\"'+y(p.value)+'\" r=\"'+(p.current?5:3)+'\" fill=\"'+(p.current?'#c43d40':'#0a8079')+'\"><title>'+esc(p.id)+': '+display(p.value)+'</title></circle>').join('')+'<text x=\"35\" y=\"158\" font-size=\"10\">'+esc(pts[0].id)+'</text><text x=\"440\" y=\"158\" font-size=\"10\">'+esc(pts.at(-1).id)+'</text></svg>';}\nfunction analyze(bid){\n if(V2.kinds.every(k=>legacyTables[k])){\n  const a=CMP.investigate(legacyTables,bid),p=a.record.Process,b=a.batch;\n  const metrics=a.metrics.map(m=>({...m,target:null,points:a.refs.map(id=>({id,value:number(legacyTables.QC.byBatch[id][m.key])})).filter(x=>x.value!=null),delta:m.value!=null&&m.mean!=null?m.value-m.mean:null}));\n  const timeRows=p?[['混合','Mix_Start_TS','Mix_End_TS',null],['대기','Mix_End_TS','Hold_End_TS',a.synthetic?60:null],['여과','Filter_Start_TS','Filter_End_TS',null],['충전','Fill_Start_TS','Fill_End_TS',null]].map(([label,start,end,upper])=>{const actual=(Date.parse(p[end])-Date.parse(p[start]))/60000;return[label==='混合'?'혼합':label,p[start],p[end],actual,'미등록',upper,upper==null?null:Math.max(0,actual-upper)];}):[];\n  return{bid,b,metrics,timeRows,raw:Object.fromEntries(V2.kinds.map(k=>[k,a.record[k]?[a.record[k]]:[]])),findings:a.findings.map(f=>({kind:f.kind,title:f.title,detail:f.current+' · '+f.basis,sources:[f.source]})),processRows:p?[['혼합 회전수 평균',number(p.Mix_RPM_Mean),'rpm',number(p.Mix_RPM_Setpoint),number(p.Mix_RPM_Mean)-number(p.Mix_RPM_Setpoint)],['혼합온도 평균',number(p.Mix_Temp_Mean_C),'°C',null,null],['혼합온도 최대',number(p.Mix_Temp_Max_C),'°C',null,null],['여과 차압 최대',number(p.Filter_DP_Max_kPa),'kPa',null,null]]:[],scopeNote:'요약 Checksheet는 원본 Batch_ID로 연결합니다. 공장 전체 교대 점검으로 임의 확대하지 않습니다.',synthetic:a.synthetic};\n }\n const a=V2.investigate(tables,bid,{scope:'SITE',type:'SHIFT_PRESTART'}),b=a.b;\n const refs=tables.Batch.rows.filter(r=>r.Batch_ID!==bid&&r.Reference_Eligible==='true'&&r.Disposition==='RELEASED'&&r.Product_ID===b.Product_ID&&r.Recipe_Rev===b.Recipe_Rev&&r.Data_Origin===b.Data_Origin&&Date.parse(r.End_TS)<Date.parse(b.Start_TS)).sort((a,b)=>Date.parse(a.End_TS)-Date.parse(b.End_TS));\n const metrics=a.qc.map(g=>{const q=g.final,points=[];if(q)for(const r of refs){const rows=tables.QC.byBatch[r.Batch_ID]||[];const matching=rows.filter(x=>x.Analyte_ID===q.Analyte_ID&&x.Is_Final==='true'&&x.Approval_Status==='APPROVED');if(matching.length!==1)continue;const x=matching[0];if(x.Qualifier==='EQ'&&x.Unit===q.Unit&&x.Method_ID===q.Method_ID&&x.Spec_Rev===q.Spec_Rev&&x.Data_Origin===q.Data_Origin&&V2.judgeQC(x,r.Data_Origin)==='규격 내')points.push({id:r.Batch_ID,value:number(x.Value)});}const value=q?.Qualifier==='EQ'?number(q.Value):null;return{label:g.id+(q?' ('+q.Unit+')':''),value,target:number(q?.Target),limit:q?[number(q.LSL),number(q.USL)]:null,points,...statistics(points,value)};});\n for(const m of metrics)if(m.n>=10&&Math.abs(m.z)>3)a.findings.push({kind:'signal',title:m.label+' 기준군 차이',detail:`현재 ${m.value}, 평균 ${m.mean.toFixed(3)}, 표준편차 ${m.sd.toFixed(3)}, ${m.z.toFixed(2)}s (탐색 신호)`,sources:[]});\n const timeRows=a.steps.map(s=>{const duration=(Date.parse(s.end)-Date.parse(s.start))/60000;const unique=k=>{const v=[...new Set(s.rows.map(r=>r[k]).filter(v=>v!=null&&v!==''))];return v.length===1?number(v[0]):null;};const target=unique('Target_Duration_min'),upper=unique('Upper_Duration_min');if(upper!=null&&duration>upper)a.findings.push({kind:'review',title:s.step+' 공정시간 초과',detail:`${duration}분 / 상한 ${upper}분 / 초과 ${duration-upper}분`,sources:s.rows.map(V2.source)});return[s.step,s.start,s.end,duration,target,upper,upper==null?null:Math.max(0,duration-upper)];});\n return{bid,b,metrics,timeRows,raw:a.records,findings:a.findings,processRows:a.process.map(g=>{const targets=[...new Set(g.rows.map(r=>r.Target_Value).filter(v=>v!=null&&v!==''))],target=targets.length===1?number(targets[0]):null;return[g.step+' / '+g.parameter+' 평균 (n='+g.count+')',g.mean,g.unit,target,target==null?null:g.mean-target];}),scopeNote:`공장 전체 교대 점검: 적용 ${a.check.required.length}건. 시간 유효구간으로 연결합니다.`,synthetic:b.Data_Origin==='SYNTHETIC'};\n}\nfunction renderFull(r){lastResult=r;$('#out').innerHTML='<section><h2>'+esc(r.bid)+' 제조 이력 보고서</h2><div class=\"row actions\"><button id=\"exportHtml\">HTML 보고서 저장</button><button id=\"printFull\">인쇄 / PDF 저장</button></div><p class=\"muted\">'+esc(r.b.Product_ID)+' / '+esc(r.b.Recipe_Rev)+' · '+esc(r.b.Start_TS)+' ~ '+esc(r.b.End_TS)+'</p><p>'+esc(r.scopeNote)+'</p>'+(r.synthetic?'':'')+'<h3>조사 결과 · '+r.findings.length+'건</h3>'+r.findings.map(f=>'<div class=\"finding\"><b>'+esc(f.title)+'</b><p>'+esc(f.detail)+'</p><small>'+esc((f.sources||[]).join('; '))+'</small></div>').join('')+(r.findings.length?'':'<p>적용 가능한 규칙에서 추가 신호 없음</p>')+'</section><section><h3>QC · 목표값 및 과거 기준군 비교</h3><p class=\"muted\">기준군: 동일 제품·처방·시험법·규격·단위, 이전 생산, Reference_Eligible=true 및 RELEASED인 비교 가능한 정상 결과. 평균은 목표값이 아닙니다. 표준편차 s는 n−1로 계산합니다.</p>'+grid(['항목','현재 값','목표값','목표값 대비 차이','기준 평균','평균 대비 차이','표준편차 s','평균에서 벗어난 정도 (표준편차 단위)','기준군 n','규격 하한 / 상한'],r.metrics.map(m=>[m.label,m.value,m.target==null?'미등록':m.target,m.value!=null&&m.target!=null?m.value-m.target:null,m.mean,m.delta,m.sd,m.z,m.n,m.limit?m.limit.map(v=>v==null?'없음':v).join(' / '):'미등록']))+'<p class=\"muted\">n≥10 및 s>0에서 |편차|>3s를 탐색 신호로 표시합니다. 기준군 부족·s=0은 통계 판정 불가입니다. 관리도 판정이나 원인 확정이 아닙니다.</p></section><section><h3>QC 경향성</h3><p class=\"muted\">생산 순서대로 정렬한 과거 기준군과 현재 Batch(빨강). 가로 간격은 Batch 순서이며 실제 시간 간격이 아닙니다. 점에 마우스를 올리면 Batch와 값이 표시됩니다.</p><div class=\"charts\">'+r.metrics.map(m=>'<div><h4>'+esc(m.label)+'</h4>'+trend(m)+'<details><summary>비교군 '+m.n+'개</summary>'+esc(m.points.map(p=>p.id).join(', '))+'</details></div>').join('')+'</div></section><section><h3>공정 값과 설정 목표값</h3>'+grid(['항목','측정값','단위','등록 목표값','목표값 대비 차이'],r.processRows)+'</section><section><h3>공정 소요시간 및 초과시간</h3><p>총 제조시간 '+display((Date.parse(r.b.End_TS)-Date.parse(r.b.Start_TS))/60000)+'분</p>'+grid(['공정','시작','종료','실제 (분)','목표값 (분)','상한 (분)','상한 초과 (분)'],r.timeRows)+'<p class=\"muted\">—는 기준 미등록 또는 계산 불가입니다. 시간 초과는 등록 상한 대비 계산하며, 상한을 목표값으로 해석하지 않습니다.</p></section><section><h3>연결 원본 기록</h3>'+Object.entries(r.raw).map(([k,rows])=>'<details><summary>'+k+' · '+rows.length+'건</summary>'+rows.map(row=>'<p>'+esc(row._file)+' · '+row._line+'행</p>'+grid(['열','값'],Object.entries(row).filter(([k])=>!k.startsWith('_')))).join('')+'</details>').join('')+'</section>';$('#printFull').onclick=()=>{document.querySelectorAll('#out details').forEach(d=>d.open=true);window.print();};$('#exportHtml').onclick=()=>{const clone=$('#out').cloneNode(true);clone.querySelectorAll('.actions').forEach(e=>e.remove());clone.querySelectorAll('details').forEach(d=>d.open=true);const text='<!doctype html><meta charset=\"utf-8\"><title>'+esc(r.bid)+'</title><style>'+document.querySelector('style').textContent+'</style>'+clone.outerHTML;const url=URL.createObjectURL(new Blob([text],{type:'text/html;charset=utf-8'})),a=document.createElement('a');a.href=url;a.download='Batch_Report_'+r.bid.replace(/[^a-z0-9_-]/gi,'_')+'.html';a.click();setTimeout(()=>URL.revokeObjectURL(url),10000);};}\nload=async function(files){try{const next={...tables},old={...legacyTables},seen=new Set();for(const f of files){const raw=new TextDecoder('utf-8',{fatal:true}).decode(await f.arrayBuffer()),parsed=V2.parseCSV(raw);let k;const markers={Batch:'Product_ID',Material:'Material_Record_ID',Process:'Process_Record_ID',Equipment:parsed.headers.includes('Equipment_Event_ID')?'Equipment_Event_ID':'Equipment_Record_ID',QC:'QC_Record_ID',Checksheet:'Checksheet_Record_ID'};k=V2.kinds.find(n=>parsed.headers.includes(markers[n]));if(!k)throw Error(f.name+': 역할 식별 불가. 필수 식별 열을 확인하세요.');if(seen.has(k))throw Error(k+' 역할이 중복 선택되었습니다.');seen.add(k);const legacy=originalSchema[k].every(field=>parsed.headers.includes(field.name));if(legacy){old[k]=CMP.readTable(k,raw,originalSchema,f.name);const rows=legacyRows(k,parsed),h=schema[k].map(x=>x.name),csv=[h,...rows.map(r=>h.map(z=>r[z]))].map(r=>r.map(v=>'\"'+String(v??'').replaceAll('\"','\"\"')+'\"').join(',')).join('\\n');next[k]=V2.readTable(k,csv,schema,f.name);next[k]._sourceCount=parsed.rows.length;}else{next[k]=V2.readTable(k,raw,schema,f.name);delete old[k];}}tables=next;legacyTables=old;refresh();$('#out').innerHTML='';msg('파일을 불러왔습니다. 상세 분석과 원본 기록을 함께 표시합니다.');}catch(e){msg(e.message,'bad');}};\n$('#report').onclick=()=>{try{ensure();renderFull(analyze($('#bid').value.trim()));}catch(e){msg(e.message,'bad');}};\n$('#scan').onclick=()=>{try{ensure();const bs=V2.filterBatches(tables.Batch.rows,$('#from').value,$('#to').value),results=bs.map(b=>analyze(b.Batch_ID)).filter(r=>r.findings.length);$('#out').innerHTML='<section><h2>날짜 범위 이상 Batch · '+results.length+'개</h2><p>규격·기록·공정시간·기준군 편차를 함께 조회합니다.</p>'+results.map((r,i)=>'<div class=\"finding\"><button data-result=\"'+i+'\">'+esc(r.bid)+'</button> '+r.findings.map(f=>esc(f.title)).join(', ')+'</div>').join('')+'</section>';document.querySelectorAll('[data-result]').forEach(e=>e.onclick=()=>{$('#bid').value=results[+e.dataset.result].bid;renderFull(results[+e.dataset.result]);});}catch(e){msg(e.message,'bad');}};\n$('#demo').textContent='기본 표본 불러오기';$('#demo').onclick=async()=>{await load(Object.entries(LEGACY_SAMPLE).map(([k,v])=>new File([v],k+'.csv',{type:'text/csv'})));$('#bid').value='SIM-B046';};\nconst clearOriginal=$('#clear').onclick;$('#clear').onclick=()=>{legacyTables={};lastResult=null;clearOriginal();};\n</script><script>/* Preserve source identity and original scope when summary/detail files mix. */\nconst loadWithAnalytics=load;\nload=async function(files){await loadWithAnalytics(files);\n for(const k of V2.kinds){const legacy=legacyTables[k],t=tables[k];if(!legacy||!t)continue;for(const r of t.rows){const source=legacy.byBatch[r.Batch_ID]||legacy.rows.find(x=>r.QC_Record_ID?.startsWith(x.QC_Record_ID+'-')||r.Checksheet_Record_ID===x.Checksheet_Record_ID||r.Equipment_Event_ID===x.Equipment_Record_ID);if(source){r._line=source._line;r._file=source._file;}}\n }\n if(legacyTables.Batch)for(const r of tables.Batch.rows)r.Reference_Eligible=legacyTables.Batch.byBatch[r.Batch_ID].Reference_Eligible;\n if(legacyTables.QC){const units={pH:'pH',Solids:'wt%',Viscoscosity:'mPa.s',Viscosity:'mPa.s',D50:'nm',D90:'nm',LPC_0p5:'count/mL',LPC_1p0:'count/mL',Zeta:'mV',Fe:'ug/kg'},keys=Object.keys(CMP.limits);for(const q of tables.QC.rows){const b=tables.Batch?.byBatch[q.Batch_ID]?.[0];q.Unit=units[q.Analyte_ID];if(b?.Product_ID==='SIM-OX-01'&&b.Recipe_Rev==='SIM-R01'&&q.Spec_Rev==='SIM-Q01'&&q.Method_ID==='SIM-QC-M01'&&q.Data_Origin==='SYNTHETIC'){const ids=['pH','Solids','Viscosity','D50','D90','LPC_0p5','LPC_1p0','Zeta','Fe'];const limits=CMP.limits[keys[ids.indexOf(q.Analyte_ID)]];q.LSL=limits[0]??'';q.USL=limits[1]??'';q.Spec_Status='DEMO';}}}\n if(legacyTables.Checksheet&&tables.Batch)for(const c of tables.Checksheet.rows){const raw=legacyTables.Checksheet.rows.find(x=>x.Checksheet_Record_ID===c.Checksheet_Record_ID),b=tables.Batch.byBatch[raw.Batch_ID]?.[0];c.Scope_Type='BATCH';c.Scope_ID=raw.Batch_ID;if(b){c.Valid_From_TS=b.Start_TS;c.Valid_To_TS=b.End_TS;}c.Result=['Line_Clearance','Cleaning_Verified','Calibration_Verified','Filter_Identity_Verified','Addition_Order_Verified'].every(k=>raw[k]==='PASS')?'PASS':'FAIL';}\n};\nconst investigateDetail=V2.investigate;\nV2.investigate=function(t,bid,opt){const result=investigateDetail(t,bid,{...opt,scope:legacyTables.Checksheet?'BATCH':opt?.scope||'SITE'});return result;};\n</script><script>(function(){\n const button=document.querySelector('#updateDat'),input=document.querySelector('#datFile'),status=document.querySelector('#updateStatus');\n button.onclick=()=>input.click();\n input.onchange=async()=>{const file=input.files[0];if(!file)return;button.disabled=true;try{\n  if(!/\\.dat$/i.test(file.name)||file.size>15*1024*1024)throw Error('15MB 이하의 CMP 업데이트 .dat 파일을 선택하세요.');\n  const pack=JSON.parse(await file.text());\n  if(pack.format!=='CMP-OFFLINE-UPDATE-1'||pack.version!=='1.0'||!['CMP_Batch_Investigator.html','CMP_Batch_Investigator_v2.html'].includes(pack.filename)||typeof pack.html!=='string')throw Error('지원하지 않는 업데이트 파일입니다.');\n  const digest=Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',new TextEncoder().encode(pack.html)))).map(x=>x.toString(16).padStart(2,'0')).join('');\n  if(digest!==pack.sha256)throw Error('파일 검증 실패: 업데이트 파일이 손상되었습니다.');\n  if(!pack.html.includes('name=\"cmp-app\" content=\"CMP-Batch-Investigator\"'))throw Error('CMP 프로그램 식별 정보가 없습니다.');\n  status.textContent='검증 완료 · '+pack.updatedAt+' · 기존 '+pack.filename+'을 선택하면 덮어씁니다. CSV 파일은 변경하지 않습니다.';\n  if(window.showSaveFilePicker){\n   const handle=await window.showSaveFilePicker({suggestedName:pack.filename,types:[{description:'CMP 프로그램',accept:{'text/html':['.html']}}]});\n   if(handle.name!==pack.filename)throw Error('기존 '+pack.filename+' 파일을 선택하세요.');\n   const writer=await handle.createWritable();await writer.write(pack.html);await writer.close();\n   const saved=await handle.getFile();if(await saved.text()!==pack.html)throw Error('저장 검증 실패');\n   status.textContent='업데이트 저장 및 검증 완료. 열린 프로그램을 새로고침하고 CSV를 다시 불러오세요.';\n  }else{\n   const url=URL.createObjectURL(new Blob([pack.html],{type:'text/html;charset=utf-8'})),a=document.createElement('a');a.href=url;a.download=pack.filename;a.click();setTimeout(()=>URL.revokeObjectURL(url),10000);\n   status.textContent='브라우저가 직접 덮어쓰기를 지원하지 않아 HTML을 다운로드했습니다. 통합 저장 폴더의 같은 이름 파일로 교체한 후 새로고침하세요. 아직 설치 완료 상태는 아닙니다.';\n  }\n }catch(e){status.textContent=e.name==='AbortError'?'업데이트를 취소했습니다. 기존 파일은 유지됩니다.':e.message;}finally{button.disabled=false;input.value='';}};\n})();\n</script><script>/* Add explicit process criteria and accessible, inspectable QC plots. */\nconst renderBeforeDetail=renderFull;\nfunction processComparison(r){\n const complete=V2.kinds.every(k=>legacyTables[k]);\n if(complete){const a=CMP.investigate(legacyTables,r.bid),keys=['Mix_RPM_Mean','Mix_Temp_Mean_C','Mix_Temp_Max_C','Filter_DP_Max_kPa'];return r.processRows.map((row,i)=>{const pts=a.refs.map(id=>({id,value:number(legacyTables.Process.byBatch[id][keys[i]])})).filter(p=>p.value!=null);const stats=statistics(pts,row[1]),upper=a.synthetic?(i===2?30:i===3?80:null):null;return [...row,upper,upper==null?null:Math.max(0,row[1]-upper),stats.mean,stats.delta,stats.sd,stats.n,upper==null?'상한 미등록':'등록 공정 검토 기준'];});}\n const a=V2.investigate(tables,r.bid,{scope:'SITE',type:'SHIFT_PRESTART'});\n return a.process.map((g,i)=>{const row=r.processRows[i],limits=[...new Set(g.rows.map(x=>x.Upper_Limit).filter(v=>v!=null&&v!==''))];let upper=limits.length===1?number(limits[0]):null,basis=limits.length>1?'상한 불일치 · 검토 필요':'등록 상한';if(!limits.length&&r.b.Data_Origin==='SYNTHETIC'&&r.b.Recipe_Rev==='SIM-R02'&&g.rows.every(x=>x.Data_Origin==='SYNTHETIC')){upper=g.parameter==='Temperature'&&g.unit==='C'?30:g.parameter==='Filter_DP'&&g.unit==='kPa'?80:null;basis='등록 공정 검토 기준';}return [row[0]+' / 최대 '+display(g.max),...row.slice(1),upper,upper==null?null:Math.max(0,g.max-upper),null,null,null,0,upper==null?'상한 또는 비교 기준군 미등록':basis+' (최대값 비교)'];});\n}\nfunction plotSVG(m,expanded=false,spacing=70,showLimits=true){\n const points=m.points.concat(m.value==null?[]:[{id:lastResult.bid,value:m.value,current:true}]);\n if(!points.length)return '<p>측정값 없음</p>';\n const lines=[];if(m.mean!=null)lines.push({value:m.mean,label:'기준 평균',color:'#708399'});if(m.target!=null)lines.push({value:m.target,label:'목표값',color:'#9165b0'});if(showLimits&&m.limit)m.limit.forEach((v,i)=>{if(v!=null)lines.push({value:v,label:i?'규격 상한':'규격 하한',color:'#b64349'});});\n const values=points.map(p=>p.value).concat(lines.map(l=>l.value)),low=Math.min(...values),high=Math.max(...values),pad=(high-low)*.12||1,min=low-pad,max=high+pad;\n const width=expanded?Math.max(900,points.length*spacing+160):580,height=expanded?460:230,left=76,right=85,top=28,bottom=expanded?130:45;\n const x=i=>left+i*(width-left-right)/Math.max(1,points.length-1),y=v=>top+(max-v)/(max-min)*(height-top-bottom);\n let svg='<svg '+(expanded?'style=\"width:'+width+'px;max-width:none\"':'')+' viewBox=\"0 0 '+width+' '+height+'\" role=\"img\" aria-label=\"'+esc(m.label)+' Batch별 측정값\"><text x=\"8\" y=\"16\" font-size=\"12\">'+esc(m.label)+'</text>';\n for(let i=0;i<=4;i++){const v=min+(max-min)*i/4;svg+='<line x1=\"'+left+'\" x2=\"'+(width-right)+'\" y1=\"'+y(v)+'\" y2=\"'+y(v)+'\" stroke=\"#c3cdd6\" stroke-dasharray=\"3 4\"/><text x=\"'+(left-8)+'\" y=\"'+(y(v)+4)+'\" text-anchor=\"end\" font-size=\"11\">'+display(v)+'</text>';}\n lines.forEach(l=>{svg+='<line x1=\"'+left+'\" x2=\"'+(width-right)+'\" y1=\"'+y(l.value)+'\" y2=\"'+y(l.value)+'\" stroke=\"'+l.color+'\" stroke-dasharray=\"7 4\"/><text x=\"'+(width-right+4)+'\" y=\"'+(y(l.value)-4)+'\" fill=\"'+l.color+'\" font-size=\"11\">'+l.label+' '+display(l.value)+'</text>';});\n svg+='<polyline fill=\"none\" stroke=\"#087f78\" stroke-width=\"2\" points=\"'+points.map((p,i)=>x(i)+','+y(p.value)).join(' ')+'\"/>';\n points.forEach((p,i)=>{if(expanded){svg+='<line x1=\"'+x(i)+'\" x2=\"'+x(i)+'\" y1=\"'+top+'\" y2=\"'+(height-bottom)+'\" stroke=\"#e2e8ed\" stroke-dasharray=\"2 5\"/><text transform=\"translate('+x(i)+','+(height-bottom+16)+') rotate(60)\" font-size=\"12\">'+esc(p.id)+'</text>';}else if(i===0||i===points.length-1){svg+='<text x=\"'+x(i)+'\" y=\"'+(height-16)+'\" text-anchor=\"middle\" font-size=\"11\">'+esc(p.id)+'</text>';}\n svg+='<circle '+(expanded?'tabindex=\"0\" role=\"button\" data-point=\"'+i+'\" aria-label=\"'+esc(p.id)+' '+display(p.value)+'\"':'')+' cx=\"'+x(i)+'\" cy=\"'+y(p.value)+'\" r=\"'+(p.current?6:4)+'\" fill=\"'+(p.current?'#c43d40':'#087f78')+'\"><title>'+esc(p.id)+' : '+display(p.value)+'</title></circle>';if(expanded)svg+='<text x=\"'+x(i)+'\" y=\"'+(y(p.value)-10)+'\" text-anchor=\"middle\" font-size=\"11\">'+display(p.value)+'</text>';});\n return svg+'<text x=\"'+left+'\" y=\"'+(height-2)+'\" font-size=\"11\">X: Batch_ID (생산 순서) · Y: 측정값 · 빨강: 선택 Batch</text></svg>';\n}\nfunction openChart(m){\n document.querySelector('#chartDialog')?.remove();const d=document.createElement('dialog');d.id='chartDialog';d.style.cssText='width:94vw;max-width:1500px;max-height:92vh;border:1px solid #9eafbe;border-radius:10px;padding:20px';d.innerHTML='<div class=\"row\"><h2 style=\"flex:1\">'+esc(m.label)+' · 상세 경향</h2><button id=\"closeChart\">닫기</button></div><div class=\"row\"><label>Batch 간격 <input id=\"chartZoom\" type=\"range\" min=\"45\" max=\"150\" value=\"75\"></label><label><input id=\"chartLimits\" type=\"checkbox\" checked> 규격선 포함</label><button id=\"resetChart\">확대 초기화</button></div><p class=\"muted\">가로로 스크롤해 각 Batch_ID와 값을 확인하세요. 점을 클릭하거나 Tab → Enter로 선택할 수 있습니다.</p><div id=\"plotArea\" style=\"overflow:auto\"></div><p id=\"pointInfo\" role=\"status\">점을 선택하면 Batch_ID와 측정값이 표시됩니다.</p><details><summary>전체 Batch_ID / 측정값 표</summary>'+grid(['Batch_ID','측정값'],m.points.concat(m.value==null?[]:[{id:lastResult.bid,value:m.value}]).map(p=>[p.id,p.value]))+'</details>';document.body.append(d);\n const draw=()=>{d.querySelector('#plotArea').innerHTML=plotSVG(m,true,+d.querySelector('#chartZoom').value,d.querySelector('#chartLimits').checked);const pts=m.points.concat(m.value==null?[]:[{id:lastResult.bid,value:m.value}]);d.querySelectorAll('[data-point]').forEach(c=>{const select=()=>{const p=pts[+c.dataset.point];d.querySelector('#pointInfo').textContent=p.id+' · '+m.label+' = '+p.value;};c.onclick=select;c.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();select();}};});};d.querySelector('#chartZoom').oninput=draw;d.querySelector('#chartLimits').onchange=draw;d.querySelector('#resetChart').onclick=()=>{d.querySelector('#chartZoom').value=75;d.querySelector('#chartLimits').checked=true;draw();};d.querySelector('#closeChart').onclick=()=>d.close();d.addEventListener('close',()=>d.remove());draw();d.showModal();\n}\nrenderFull=function(r){renderBeforeDetail(r);const section=[...document.querySelectorAll('#out section')].find(s=>s.querySelector('h3')?.textContent==='공정 값과 설정 목표값');if(section){section.id='processComparison';section.innerHTML='<h3>공정 값 · 목표값 · 검토 상한 · 정상 기준군</h3><p class=\"muted\">목표값은 설정 목표, 상한은 이슈 검토 기준, 기준군 평균은 정상 이력의 통계값입니다. 서로 대체하지 않습니다.</p>'+grid(['항목','측정값','단위','등록 목표값','목표값 대비 차이','검토 상한','상한 초과량','정상 기준군 평균','평균 대비 차이','표준편차 s','기준군 n','상한 출처'],processComparison(r))+'<p class=\"muted\">요약 데이터 기준군은 QC 비교에 사용한 동일 과거 정상 Batch입니다. —는 미등록 또는 계산 불가입니다. 상세 데이터는 최대값과 상한을 비교하며, 비교군이 검증되지 않으면 평균을 임의 생성하지 않습니다.</p>';}\n document.querySelectorAll('#out .charts>div').forEach((card,i)=>{const m=r.metrics[i];card.querySelector('svg')?.remove();const box=document.createElement('div');box.innerHTML=plotSVG(m);const button=document.createElement('button');button.textContent='확대 · Batch별 값 보기';button.className='actions';button.onclick=()=>openChart(m);box.onclick=()=>openChart(m);box.style.cursor='zoom-in';card.insertBefore(box,card.querySelector('details'));card.append(button);});\n};\n</script><script>(function(root){'use strict';\nconst mean=a=>a.reduce((s,v)=>s+v,0)/a.length;\nconst sd=a=>a.length>1?Math.sqrt(a.reduce((s,v)=>s+(v-mean(a))**2,0)/(a.length-1)):null;\nfunction capability(rows,{lsl=null,usl=null,k=3,within='none'}={}){\n if(![3,6].includes(k))throw Error('시그마 배수는 3 또는 6입니다.');\n if([lsl,usl].some(x=>x!==null&&!Number.isFinite(x)))throw Error('규격은 유한한 숫자여야 합니다.');\n if(lsl!==null&&usl!==null&&lsl>=usl)throw Error('LSL은 USL보다 작아야 합니다.');\n const values=rows.map(r=>r.y);if(values.length<2||values.some(v=>!Number.isFinite(v)))throw Error('유효한 측정값이 2개 이상 필요합니다.');\n const mu=mean(values),overall=sd(values);let sw=null,mr=[];\n if(within==='mr'){if(new Set(rows.map(r=>r.equipment)).size!==1)throw Error('이동범위법은 설비 1개를 선택하세요.');if(rows.some((r,i)=>i&&r.time<=rows[i-1].time))throw Error('이동범위법은 중복 없는 시간순 기록이 필요합니다.');mr=values.slice(1).map((v,i)=>Math.abs(v-values[i]));sw=mean(mr)/1.128;}\n const idx=(s,d)=>({upper:s>0&&usl!==null?(usl-mu)/(d*s):null,lower:s>0&&lsl!==null?(mu-lsl)/(d*s):null,both:s>0&&lsl!==null&&usl!==null?Math.min(usl-mu,mu-lsl)/(d*s):null,spread:s>0&&lsl!==null&&usl!==null?(usl-lsl)/(2*d*s):null});\n const w=idx(sw,3),o=idx(overall,3),custom=idx(overall,k);\n return{n:values.length,mean:mu,overall,within:sw,mr,lsl,usl,k,Cp:w.spread,Cpk:w.both,Cpu:w.upper,Cpl:w.lower,Pp:o.spread,Ppk:o.both,Ppu:o.upper,Ppl:o.lower,customUpper:custom.upper,customLower:custom.lower,lowerBand:mu-k*overall,upperBand:mu+k*overall,outside:rows.filter(r=>(lsl!==null&&r.y<lsl)||(usl!==null&&r.y>usl)),signals:overall>0?rows.filter(r=>Math.abs(r.y-mu)>k*overall):[],imrSignals:sw>0?rows.filter(r=>Math.abs(r.y-mu)>3*sw):[]};\n}\nfunction regression(rows){const a=rows.filter(r=>Number.isFinite(r.x)&&Number.isFinite(r.y));if(a.length<3)throw Error('회귀에는 X·Y가 짝지어진 Batch 3개 이상이 필요합니다.');const xs=a.map(r=>r.x),ys=a.map(r=>r.y),mx=mean(xs),my=mean(ys),xx=xs.reduce((s,x)=>s+(x-mx)**2,0),yy=ys.reduce((s,y)=>s+(y-my)**2,0),xy=a.reduce((s,r)=>s+(r.x-mx)*(r.y-my),0);if(xx===0||yy===0)throw Error('X 또는 Y가 일정하여 상관·R²를 계산할 수 없습니다.');const slope=xy/xx,intercept=my-slope*mx,residuals=a.map(r=>({...r,residual:r.y-(intercept+slope*r.x)})),sse=residuals.reduce((s,r)=>s+r.residual**2,0);return{n:a.length,slope,intercept,r:xy/Math.sqrt(xx*yy),r2:Math.max(0,Math.min(1,1-sse/yy)),rmse:Math.sqrt(sse/(a.length-2)),residuals};}\nfunction ranks(a){const sorted=a.map((v,i)=>({v,i})).sort((a,b)=>a.v-b.v),out=[];for(let i=0;i<sorted.length;){let j=i+1;while(j<sorted.length&&sorted[j].v===sorted[i].v)j++;for(let t=i;t<j;t++)out[sorted[t].i]=(i+j+1)/2;i=j;}return out;}\nfunction spearman(rows){const a=rows.filter(r=>Number.isFinite(r.x)&&Number.isFinite(r.y)),x=ranks(a.map(r=>r.x)),y=ranks(a.map(r=>r.y));return regression(a.map((r,i)=>({x:x[i],y:y[i]}))).r;}\nfunction contribution(rows){const groups=new Map();for(const r of rows){if(!r.group)throw Error('분산성분의 그룹 값 누락');if(!groups.has(r.group))groups.set(r.group,[]);groups.get(r.group).push(r.y);}const a=[...groups.values()],N=rows.length,g=a.length;if(g<2||a.some(v=>v.length<2))throw Error('분산성분에는 그룹 2개 이상, 각 그룹 관측값 2개 이상이 필요합니다.');const grand=mean(rows.map(r=>r.y)),ssb=a.reduce((s,v)=>s+v.length*(mean(v)-grand)**2,0),sse=a.reduce((s,v)=>s+v.reduce((z,y)=>z+(y-mean(v))**2,0),0),msb=ssb/(g-1),mse=sse/(N-g),n0=(N-a.reduce((s,v)=>s+v.length**2,0)/N)/(g-1),raw=(msb-mse)/n0,between=Math.max(0,raw),total=between+mse;return{groups:g,n:N,between,residual:mse,rawBetween:raw,percent:total>0?100*between/total:null};}\nroot.CMPStats={mean,sd,capability,regression,spearman,contribution};if(typeof module!=='undefined')module.exports=root.CMPStats;\n})(globalThis);\n</script><script>(function(root){\nconst quantile=(values,p)=>{const a=[...values].sort((a,b)=>a-b),i=(a.length-1)*p,lo=Math.floor(i);return a[lo]+(a[Math.ceil(i)]-a[lo])*(i-lo);};\nfunction summary(rows){const v=rows.map(r=>r.y),q1=quantile(v,.25),median=quantile(v,.5),q3=quantile(v,.75),iqr=q3-q1,inner=v.filter(x=>x>=q1-1.5*iqr&&x<=q3+1.5*iqr);return{n:v.length,min:Math.min(...v),max:Math.max(...v),q1,median,q3,iqr,low:Math.min(...inner),high:Math.max(...inner),outliers:rows.filter(r=>r.y<q1-1.5*iqr||r.y>q3+1.5*iqr)};}\nfunction histogram(values,count){const min=Math.min(...values),max=Math.max(...values),lo=min===max?min-.5:min,hi=min===max?max+.5:max,bins=Array.from({length:count},(_,i)=>({lo:lo+(hi-lo)*i/count,hi:lo+(hi-lo)*(i+1)/count,n:0}));values.forEach(v=>bins[Math.min(count-1,Math.max(0,Math.floor((v-lo)/(hi-lo)*count)))].n++);return bins;}\nfunction wilson(fail,n){if(!n)return[null,null];const z=1.95996398454,p=fail/n,d=1+z*z/n,mid=(p+z*z/(2*n))/d,half=z*Math.sqrt(p*(1-p)/n+z*z/(4*n*n))/d;return[Math.max(0,mid-half),Math.min(1,mid+half)];}\nconst groups=rows=>[...new Set(rows.map(r=>r.equipment))].map(name=>({name,rows:rows.filter(r=>r.equipment===name)}));\nconst choices=[['hist','Histogram','전체 분포·치우침과 규격 위치'],['box','Box Plot · 설비별','중앙값·산포·통계적 이상점 비교'],['trend','시간순 추세','시간에 따른 변화와 관심 LOT 위치'],['scatter','X–Y 산점도','인자 간 관계와 단순 회귀선'],['residual','잔차 vs 예측값','회귀의 곡선 패턴·불균일 산포 확인'],['imr','I–MR 관리도','동일 설비의 수준·변동 변화'],['lag','Lag-1 Plot','직전 Batch와의 이전 Batch와의 연관성 확인'],['pareto','규격 이탈 Pareto','설비별 이탈 건수 우선순위와 이탈률']];\nfunction setup(panel){\n const methods=panel.querySelector('[name=statMethod]').parentElement.parentElement,desc={cap:['공정능력','Cp/Cpk/Cpu/Cpl · Pp/Ppk/Ppu/Ppl','규격 입력, Cpk는 군내 추정 검토 필요'],xy:['인자 관계','Pearson/Spearman · 회귀 R²','같은 Batch의 X·Y 수치 쌍'],dist:['분포·그래프','선택한 그래프 및 분포표','아래에서 발표에 필요한 그림 선택'],grp:['그룹 비교','설비 또는 원료 LOT별 평균·이탈 집중도','그룹 요인 선택, 이탈 집계는 규격 입력 필요'],vc:['분산성분','그룹 간 %Contribution (설비 또는 원료 LOT)','그룹을 더 큰 집단의 표본으로 보는 가정 확인 필요']};\n const table=document.createElement('table');table.className='analysis-options';table.innerHTML='<caption>분석 항목 선택</caption><thead><tr><th>선택 / 분석</th><th>제공 내용</th><th>필요 조건</th></tr></thead><tbody>'+Object.entries(desc).map(([id,[name,detail,need]])=>'<tr><td><label class=\"check-row\"><input type=\"checkbox\" name=\"statMethod\" value=\"'+id+'\" '+(id==='vc'?'':'checked')+'>'+name+'</label></td><td>'+detail+'</td><td>'+need+'</td></tr>').join('')+'<tr><td><label class=\"check-row\"><input type=\"checkbox\" name=\"statMethod\" value=\"diag\" checked>공정 진단</label></td><td>중앙값·IQR, 실측 이탈률·95% 구간, 설비별 비교</td><td>규격 미등록 시 이탈률은 계산하지 않음</td></tr></tbody>';methods.replaceWith(table);\n const graphs=document.createElement('div');graphs.innerHTML='<h3>그래프 선택</h3><p class=\"muted\">분석 수치와 그래프는 따로 선택할 수 있습니다. 선택한 그림은 결과 HTML에 포함되며 SVG로도 저장할 수 있습니다.</p><table class=\"analysis-options\"><thead><tr><th>선택 / 그래프</th><th>확인할 내용</th></tr></thead><tbody>'+choices.map(([id,name,why])=>'<tr><td><label class=\"check-row\"><input type=\"checkbox\" name=\"statGraph\" value=\"'+id+'\" '+(['hist','box','trend','scatter'].includes(id)?'checked':'')+'>'+name+'</label></td><td>'+why+'</td></tr>').join('')+'</tbody></table><div class=\"row\"><label>Histogram 구간 수<select id=\"statBins\"><option>5</option><option selected>10</option><option>15</option><option>20</option><option>30</option></select></label></div>';table.after(graphs);\n for(const id of ['statAssume','statRandom'])panel.querySelector('#'+id).parentElement.classList.add('check-row','assumption-row');\n const basis=panel.querySelector('#statBasis');basis.placeholder='예: 제품 규격서 QC-001 Rev.3';basis.setAttribute('aria-describedby','specHelp');const help=document.createElement('p');help.id='specHelp';help.className='muted';help.textContent='규격 출처 / 개정 = 상·하한의 근거 문서와 버전입니다. 예: 고객 승인 규격 QC-001 Rev.3. 입력한 근거는 결과 보고서에 함께 저장합니다.';basis.parentElement.parentElement.after(help);\n}\nlet clipSequence=0;\nfunction chart(title,xlabel,ylabel,points,{line=false,refs=[],fit=null,bars=false,rangeX=null,rangeY=null,categories=false}={}){\n if(!points.length)return '<p>표시할 값이 없습니다.</p>';const xx=points.map(p=>p.x),yy=points.map(p=>p.y).concat(refs.filter(r=>r.axis==='y').map(r=>r.value));if(bars)xx.push(...points.flatMap(p=>[p.lo,p.hi]));xx.push(...refs.filter(r=>r.axis==='x').map(r=>r.value));if(fit)yy.push(...[Math.min(...xx),Math.max(...xx)].map(x=>fit.intercept+fit.slope*x));\n const span=(a,forced)=>{if(forced)return forced;const min=Math.min(...a),max=Math.max(...a),pad=(max-min)*.07||.5;return[min-pad,max+pad];},xr=span(xx,rangeX),yr=span(yy,rangeY),x=v=>76+(v-xr[0])/(xr[1]-xr[0]||1)*660,y=v=>292-(v-yr[0])/(yr[1]-yr[0]||1)*230;\n const clip='cmp-plot-'+(++clipSequence);let svg='<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 820 380\" role=\"img\" aria-label=\"'+esc(title)+'\"><rect width=\"820\" height=\"380\" fill=\"white\"/><text x=\"76\" y=\"24\" font-size=\"16\" fill=\"#182d45\">'+esc(title)+'</text>';\n for(let i=0;i<=4;i++){const vx=xr[0]+(xr[1]-xr[0])*i/4,vy=yr[0]+(yr[1]-yr[0])*i/4;svg+='<path d=\"M76 '+y(vy)+' H736 M'+x(vx)+' 62 V292\" stroke=\"#cbd5df\" stroke-dasharray=\"3 4\"/><text x=\"70\" y=\"'+(y(vy)+4)+'\" text-anchor=\"end\" font-size=\"11\">'+display(vy)+'</text><text x=\"'+x(vx)+'\" y=\"311\" text-anchor=\"middle\" font-size=\"11\">'+display(vx)+'</text>';}\n refs.forEach(r=>{const pos=r.axis==='x'?x(r.value):y(r.value);svg+='<path d=\"'+(r.axis==='x'?'M'+pos+' 62 V292':'M76 '+pos+' H736')+'\" stroke=\"'+(r.color||'#b84046')+'\" stroke-dasharray=\"7 4\"/><text x=\"'+(r.axis==='x'?Math.max(115,Math.min(690,pos)):730)+'\" y=\"'+(r.axis==='x'?45:pos-5)+'\" text-anchor=\"end\" font-size=\"10\">'+esc(r.label)+' '+display(r.value)+'</text>';});\n svg+='<defs><clipPath id=\"'+clip+'\"><rect x=\"76\" y=\"62\" width=\"660\" height=\"230\"/></clipPath></defs><g class=\"plot-marks\" clip-path=\"url(#'+clip+')\">';if(bars)points.forEach(p=>{svg+='<rect x=\"'+x(p.lo)+'\" y=\"'+y(p.y)+'\" width=\"'+Math.max(1,x(p.hi)-x(p.lo)-2)+'\" height=\"'+Math.max(0,y(0)-y(p.y))+'\" fill=\"#12867d\"><title>'+esc(p.id)+'</title></rect>';});\n else {if(line)svg+='<polyline points=\"'+points.map(p=>x(p.x)+','+y(p.y)).join(' ')+'\" fill=\"none\" stroke=\"#16867c\" stroke-width=\"1.5\"/>';svg+=points.map(p=>'<circle cx=\"'+x(p.x)+'\" cy=\"'+y(p.y)+'\" r=\"3.5\" fill=\"'+(p.highlight?'#c23940':'#087f78')+'\"><title>'+esc(p.id)+': X='+display(p.x)+', Y='+display(p.y)+'</title></circle>').join('');}\n if(fit)svg+='<path d=\"M'+x(xr[0])+' '+y(fit.intercept+fit.slope*xr[0])+' L'+x(xr[1])+' '+y(fit.intercept+fit.slope*xr[1])+'\" stroke=\"#98529f\" stroke-width=\"2\"/>';\n svg+='</g>';if(categories){svg=svg.replace(/<text x=\"[^\"]+\" y=\"311\"[^>]*>[^<]*<\\/text>/g,'');svg+=points.map(p=>'<text x=\"'+x(p.x)+'\" y=\"315\" text-anchor=\"middle\" font-size=\"12\">'+esc(p.id)+'</text>').join('');}return svg+'<text x=\"406\" y=\"346\" text-anchor=\"middle\" font-size=\"12\">'+esc(xlabel.length>85?xlabel.slice(0,82)+'…':xlabel)+'</text><text x=\"76\" y=\"366\" font-size=\"12\">Y: '+esc(ylabel.length>90?ylabel.slice(0,87)+'…':ylabel)+'</text></svg>';\n}\nfunction boxes(rows,label){const gs=groups(rows),stats=gs.map(g=>({...g,...summary(g.rows)})),min=Math.min(...rows.map(r=>r.y)),max=Math.max(...rows.map(r=>r.y)),pad=(max-min)*.1||1,y=v=>285-(v-min+pad)/(max-min+2*pad)*225,w=Math.max(820,gs.length*140+130);let out='<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 '+w+' 360\" role=\"img\" aria-label=\"설비별 Box Plot\"><rect width=\"100%\" height=\"100%\" fill=\"white\"/><text x=\"70\" y=\"25\" font-size=\"16\">설비별 Box Plot</text>';\n for(let i=0;i<=4;i++){const v=min-pad+(max-min+2*pad)*i/4;out+='<path d=\"M70 '+y(v)+' H'+(w-30)+'\" stroke=\"#cbd5df\" stroke-dasharray=\"3 4\"/><text x=\"60\" y=\"'+y(v)+'\" text-anchor=\"end\" font-size=\"11\">'+display(v)+'</text>';}\n stats.forEach((g,i)=>{const x=120+(i+.5)*(w-170)/stats.length;out+='<path d=\"M'+x+' '+y(g.low)+' V'+y(g.high)+' M'+(x-22)+' '+y(g.low)+' h44 M'+(x-22)+' '+y(g.high)+' h44\" stroke=\"#087f78\"/><rect x=\"'+(x-32)+'\" y=\"'+y(g.q3)+'\" width=\"64\" height=\"'+Math.max(1,y(g.q1)-y(g.q3))+'\" fill=\"#c4e8e1\" stroke=\"#087f78\"/><path d=\"M'+(x-32)+' '+y(g.median)+' h64\" stroke=\"#152b40\" stroke-width=\"3\"/><text x=\"'+x+'\" y=\"312\" text-anchor=\"middle\">'+esc(g.name)+'</text><text x=\"'+x+'\" y=\"330\" text-anchor=\"middle\" font-size=\"11\">n='+g.n+'</text>'+g.outliers.map(r=>'<circle cx=\"'+x+'\" cy=\"'+y(r.y)+'\" r=\"4\" fill=\"#c23940\"><title>'+esc(r.id)+': '+r.y+'</title></circle>').join('');});return out+'<text x=\"70\" y=\"353\" font-size=\"12\">Y: '+esc(label)+'</text></svg>'+grid(['설비','n','최소','Q1','중앙값','Q3','최대','1.5 IQR 밖'],stats.map(g=>[g.name,g.n,g.min,g.q1,g.median,g.q3,g.max,g.outliers.length]));}\nfunction diagnostics(rows,c){const s=summary(rows),hasSpec=c.lsl!=null||c.usl!=null,rate=c.outside.length/rows.length,ci=wilson(c.outside.length,rows.length);return '<h3>추가 공정 진단</h3>'+grid(['중앙값','IQR','최소','최대','실측 규격 이탈률 %','95% 구간 %'],[[s.median,s.iqr,s.min,s.max,hasSpec?rate*100:null,hasSpec?ci.map(v=>display(v*100)).join(' ~ '):'규격 미등록']])+'<p>이탈률은 이번 Y의 유효 Batch 기준이며 공장 전체 불량률이나 예측 DPMO가 아닙니다. 95% Wilson 구간은 독립적인 이항 관측을 가정합니다.</p>'+grid(['설비','n','평균','표준편차','중앙값','규격 이탈 수','이탈률 %'],groups(rows).map(g=>{const n=g.rows.filter(r=>(c.lsl!=null&&r.y<c.lsl)||(c.usl!=null&&r.y>c.usl)).length;return[g.name,g.rows.length,CMPStats.mean(g.rows.map(r=>r.y)),CMPStats.sd(g.rows.map(r=>r.y)),summary(g.rows).median,hasSpec?n:null,hasSpec?n/g.rows.length*100:null];}));}\nfunction render({rows,c,s,xs,target}){const selected=[...document.querySelectorAll('[name=statGraph]:checked')].map(e=>e.value),lookup=new Map(xs.rows.map(r=>[r.id,r.y])),pairs=rows.filter(r=>lookup.has(r.id)).map(r=>({...r,x:lookup.get(r.id)})),refs=[['LSL',c.lsl],['USL',c.usl],['목표값',target]].filter(([,v])=>v!=null).map(([label,value])=>({label,value,axis:'x'}));let html='';\n const add=(id,title,why,body)=>{html+='<section class=\"stat-figure\" data-graph=\"'+id+'\"><h3>'+title+'</h3><p>'+why+'</p><div class=\"figure-scroll\">'+body+'</div><button class=\"save-figure\" type=\"button\">그림 SVG 저장</button></section>';};\n for(const id of selected){try{\n if(id==='hist'){const bins=histogram(rows.map(r=>r.y),+$('#statBins').value);add(id,'Histogram · 선택 Y의 분포','막대는 구간별 Batch 수입니다. 규격선 밖 데이터와 치우침을 확인하세요. 분포 모양만으로 정규성을 확정하지 않습니다.',chart('Histogram','Y 측정값','Batch 수',bins.map(b=>({x:(b.lo+b.hi)/2,y:b.n,lo:b.lo,hi:b.hi,id:display(b.lo)+' ~ '+display(b.hi)+' : '+b.n})),{bars:true,refs,rangeY:[0,Math.max(1,...bins.map(b=>b.n))*1.12]})+'<details><summary>구간별 수치</summary>'+grid(['이상','미만 (마지막 이하)','개수'],bins.map(b=>[b.lo,b.hi,b.n]))+'</details>');}\n if(id==='box')add(id,'Box Plot · 설비별 비교','상자는 Q1~Q3, 굵은 선은 중앙값입니다. 수염은 1.5×IQR 안의 관측 범위, 빨간 점은 그 밖의 값입니다. 통계적 이상점은 규격 불량과 다릅니다. 사분위수는 선형보간 방식입니다.',boxes(rows,s.label));\n if(id==='trend')add(id,'시간순 추세','X축은 시간순 Batch 순번입니다. 점에 마우스를 올리면 Batch_ID와 값을 확인합니다. 설비가 섞여 있으면 설비 필터로 나누어 보세요.',chart('시간순 추세','시간순 Batch 순번',s.label,rows.map((r,i)=>({x:i+1,y:r.y,id:r.id,highlight:r.id===$('#statFocus').value})),{line:true,refs:refs.map(r=>({...r,axis:'y'})).concat([{axis:'y',value:c.mean,label:'평균',color:'#657c8d'}])}));\n if(id==='scatter'||id==='residual'){const reg=CMPStats.regression(pairs);add(id,id==='scatter'?'X–Y 산점도와 회귀선':'잔차 vs 예측값',id==='scatter'?'점은 동일 Batch의 X·Y입니다. 보라색 선은 단순 선형 회귀입니다. 관계가 원인을 확정하지 않습니다.':'잔차=관측 Y−예측 Y. 곡선 패턴이나 부채꼴 산포가 있으면 선형성·예측값에 따라 오차 크기가 일정한지을 재검토하세요.',chart(id==='scatter'?'X–Y 산점도':'잔차 vs 예측값',id==='scatter'?xs.label:'예측 Y',id==='scatter'?s.label:'잔차',id==='scatter'?pairs:reg.residuals.map(r=>({...r,x:reg.intercept+reg.slope*r.x,y:r.residual})),id==='scatter'?{fit:reg}:{refs:[{axis:'y',value:0,label:'0'}]}));}\n if(id==='imr'){if(!(c.within>0))throw Error('설비 1개와 MR 추정법·적용성 확인을 선택하세요. 변동 0이면 한계 추정 불가입니다.');const mrMean=CMPStats.mean(c.mr),mrMax=3.267*mrMean;add(id,'I–MR 관리도','규격선이 아닌 공정 관리한계입니다. I 한계=평균±3σwithin, MR 상한=3.267×MR 평균. 같은 자료로 한계를 추정한 탐색 차트이며 전체 이상 규칙을 적용한 안정성 판정은 아닙니다.',chart('I 관리도','시간순 Batch 순번',s.label,rows.map((r,i)=>({x:i+1,y:r.y,id:r.id,highlight:Math.abs(r.y-c.mean)>3*c.within})),{line:true,refs:[{axis:'y',value:c.mean,label:'CL'},{axis:'y',value:c.mean+3*c.within,label:'UCL'},{axis:'y',value:c.mean-3*c.within,label:'LCL'}]})+chart('MR 관리도','후행 Batch 순번','인접 값 차이의 절댓값',c.mr.map((v,i)=>({x:i+2,y:v,id:rows[i].id+' → '+rows[i+1].id,highlight:v>mrMax})),{line:true,refs:[{axis:'y',value:mrMean,label:'CL'},{axis:'y',value:mrMax,label:'UCL'},{axis:'y',value:0,label:'LCL'}]})+'<p>I 단일점 신호 '+c.imrSignals.length+'건 / MR 상한 초과 '+c.mr.filter(v=>v>mrMax).length+'건</p>');}\n if(id==='lag'){if(new Set(rows.map(r=>r.equipment)).size!==1||rows.some((r,i)=>i&&r.time<=rows[i-1].time))throw Error('Lag Plot은 중복 없는 시간순 기록과 설비 1개를 선택하세요.');const lag=rows.slice(1).map((r,i)=>({id:rows[i].id+' → '+r.id,x:rows[i].y,y:r.y}));let rho='계산 불가';try{rho=display(CMPStats.regression(lag).r);}catch{}add(id,'Lag-1 Plot · 이전 Batch와의 연관성','직전 Y와 현재 Y의 Pearson r='+rho+'. 강한 패턴은 독립성 재검토 신호입니다. 불규칙한 측정 간격은 같은 시간 지연을 의미하지 않습니다.',chart('Lag-1 Plot','직전 Batch Y','현재 Batch Y',lag));}\n if(id==='pareto'){if(c.lsl==null&&c.usl==null)throw Error('규격 하한 또는 상한을 입력하세요.');const g=groups(rows).map(g=>({...g,fail:g.rows.filter(r=>(c.lsl!=null&&r.y<c.lsl)||(c.usl!=null&&r.y>c.usl)).length})).sort((a,b)=>b.fail-a.fail),total=g.reduce((a,b)=>a+b.fail,0);let cum=0;add(id,'규격 이탈 Pareto · 설비별','막대는 이탈 건수 순위입니다. 표의 누적 비율과 이탈률을 함께 보세요. 생산량 차이 때문에 건수 순위가 설비 위험 순위와 같지는 않습니다.',chart('설비별 이탈 건수','설비','이탈 Batch 수',g.map((g,i)=>({x:i+1,y:g.fail,lo:i+.65,hi:i+1.35,id:g.name})),{bars:true,categories:true,rangeY:[0,Math.max(1,...g.map(g=>g.fail))*1.15]})+grid(['순위','설비','전체 n','이탈 건수','이탈률 %','누적 이탈 비중 %'],g.map((g,i)=>{cum+=g.fail;return[i+1,g.name,g.rows.length,g.fail,g.fail/g.rows.length*100,total?cum/total*100:null];})));}\n }catch(e){html+='<p class=\"warn\" data-graph-error=\"'+id+'\">'+esc(choices.find(c=>c[0]===id)[1])+': '+esc(e.message)+'</p>';}}\n return html;\n}\nfunction wire(){document.querySelectorAll('#statResults .save-figure').forEach(button=>button.onclick=()=>{const figs=[...button.closest('.stat-figure').querySelectorAll('svg')];figs.forEach((svg,i)=>{const a=document.createElement('a'),url=URL.createObjectURL(new Blob([svg.outerHTML],{type:'image/svg+xml;charset=utf-8'}));a.href=url;a.download=button.closest('.stat-figure').dataset.graph+(i?'_'+(i+1):'')+'.svg';a.click();setTimeout(()=>URL.revokeObjectURL(url),10000);});});}\nroot.StatsVisual={setup,render,diagnostics,wire,summary,histogram,wilson,chart};if(typeof module!=='undefined')module.exports=root.StatsVisual;\n})(globalThis);\n</script><script>(function(){\nlet catalogue=[],result=null;const button=document.createElement('button');button.id='statisticsOpen';button.textContent='2단계 · LOT 통계 분석';button.className='primary';document.querySelector('#report').parentElement.append(button);\nfunction collect(){const map=new Map();const add=(key,label,b,value,meta={})=>{if(!Number.isFinite(value))return;const signature=JSON.stringify([key,b.Product_ID,b.Recipe_Rev,b.Data_Origin,meta.unit,meta.method,meta.spec]);if(!map.has(signature))map.set(signature,{label:label+' / '+[b.Product_ID,b.Recipe_Rev,meta.unit,meta.method,meta.spec,b.Data_Origin].filter(Boolean).join(' · '),key,rows:[]});map.get(signature).rows.push({id:b.Batch_ID,time:Date.parse(b.Start_TS),equipment:b.Equipment_ID,y:value,group:b.Equipment_ID,...meta});};\n for(const b of tables.Batch.rows){const id=b.Batch_ID;\n  if(legacyTables.QC){const q=legacyTables.QC.byBatch[id];if(q)for(const key of Object.keys(CMP.limits)){const value=number(q[key]);if(value!=null&&(key!=='Fe_ug_kg'||q.Fe_Qualifier==='EQ'))add('QC:'+key,CMP.metricLabels[key],b,value,{unit:CMP.metricLabels[key],method:q.Method_Set_ID,spec:q.Spec_Rev});}}\n  else {const groups=new Map();for(const q of tables.QC.byBatch[id]||[]){if(!groups.has(q.Analyte_ID))groups.set(q.Analyte_ID,[]);groups.get(q.Analyte_ID).push(q);}for(const [key,rows]of groups){const finals=rows.filter(q=>q.Is_Final==='true'&&q.Approval_Status==='APPROVED');if(finals.length===1&&finals[0].Qualifier==='EQ'&&number(finals[0].Value)!=null){const q=finals[0];if(q.Data_Origin===b.Data_Origin)add('QC:'+key,key,b,number(q.Value),{unit:q.Unit,method:q.Method_ID,spec:q.Spec_Rev});}}}\n  if(legacyTables.Process){const p=legacyTables.Process.byBatch[id];if(p)for(const[key,unit]of [['Mix_RPM_Mean','rpm'],['Mix_Temp_Mean_C','C'],['Mix_Temp_Max_C','C'],['Filter_DP_Max_kPa','kPa'],['Filter_Flow_Mean_L_min','L/min']])if(number(p[key])!=null)add('Process:'+key,key,b,number(p[key]),{unit});}\n  else {const groups=new Map();for(const p of tables.Process.byBatch[id]||[]){if(p.Equipment_ID!==b.Equipment_ID||p.Data_Origin!==b.Data_Origin)continue;const key=JSON.stringify([p.Step_ID,p.Parameter,p.Unit]);if(!groups.has(key))groups.set(key,[]);groups.get(key).push(number(p.Value));}for(const[key,values]of groups){const[step,param,unit]=JSON.parse(key);for(const mode of ['평균','최대'])add('Process:'+key+mode,step+'/'+param+' '+mode,b,mode==='평균'?CMPStats.mean(values):Math.max(...values),{unit});}}\n }\n return [...map.values()].map(s=>({...s,rows:s.rows.sort((a,b)=>a.time-b.time)}));}\nconst options=list=>list.map((s,i)=>'<option value=\"'+i+'\">'+esc(s.label)+'</option>').join('');\nfunction open(){try{ensure();catalogue=collect();if(!catalogue.length)throw Error('분석 가능한 수치가 없습니다.');document.querySelector('#statsPanel')?.remove();const panel=document.createElement('section');panel.id='statsPanel';panel.innerHTML='<h2>2단계 · LOT 통계 분석 조건</h2><p>선택한 제품·처방·시험법·규격·단위·데이터 종류별로 분석합니다. 불량 LOT만 모아 계산하지 않고 선택 범위의 정상·이탈 Batch를 모두 포함합니다. 단일 LOT는 해당 집단에서 위치를 확인합니다.</p><div class=\"row\"><label>Y 분석 특성<select id=\"statY\">'+options(catalogue)+'</select></label><label>X 설명 인자<select id=\"statX\">'+options(catalogue)+'</select></label></div><div class=\"row\"><label>설비<select id=\"statEquipment\"><option value=\"\">전체 설비</option></select></label><label>그룹 요인<select id=\"statFactor\"><option value=\"\">설비</option>'+[...new Set(((tables.Material&&tables.Material.rows)||[]).map(r=>r.Material_ID).filter(Boolean))].map(v=>'<option value=\"'+esc(v)+'\">'+esc(v)+' 원료 LOT</option>').join('')+'</select></label><label>시작일<input id=\"statFrom\" type=\"date\"></label><label>종료일<input id=\"statTo\" type=\"date\"></label><label>관심 Batch_ID<input id=\"statFocus\" placeholder=\"예: SIM-S0220\"></label></div><div class=\"row\"><label>Y 규격 하한 LSL<input id=\"statLSL\" type=\"number\" step=\"any\" placeholder=\"없으면 비움\"></label><label>Y 규격 상한 USL<input id=\"statUSL\" type=\"number\" step=\"any\" placeholder=\"없으면 비움\"></label><label>Y 목표값 (선택)<input id=\"statTarget\" type=\"number\" step=\"any\"></label><label>규격 출처 / 개정<input id=\"statBasis\" placeholder=\"예: 승인 규격 Rev.A 또는 가상 기준\"></label></div><div class=\"row\"><label>탐색 범위<select id=\"statK\"><option value=\"3\">평균 ±3σ (전체 폭 6σ)</option><option value=\"6\">평균 ±6σ (전체 폭 12σ)</option></select></label><label>군내 σ 추정<select id=\"statWithin\"><option value=\"none\">미지정 · Ppk 계열만 계산</option><option value=\"mr\">동일 설비 시간순 이동범위 MR̄/1.128</option></select></label></div><p class=\"muted\">표준 Cpk/Cpu 및 Ppk/Ppu의 분모는 3σ로 고정됩니다. 위 배수 선택은 전체 σ 탐색 범위와 별도 사용자 시그마 배수별 참고 지표에 적용됩니다. 규격한계는 공정 관리한계와 다릅니다. Batch 평균에 대한 분석은 개별 입자·반복 측정의 능력지수가 아닙니다.</p><label><input id=\"statAssume\" type=\"checkbox\">동일 설비 시간순 관측의 독립성과 군내 추정 적용성을 검토했습니다 (Cpk 계열)</label><div class=\"row\">'+[['cap','공정능력 Cp/Cpk/Cpu/Cpl · Pp/Ppk/Ppu/Ppl'],['xy','Pearson/Spearman · 회귀 R²'],['dist','분포·시간순 추세'],['grp','그룹 비교 · 설비 / 원료 LOT'],['vc','그룹 간 %Contribution']].map(([v,l])=>'<label><input type=\"checkbox\" name=\"statMethod\" value=\"'+v+'\" '+(v==='vc'?'':'checked')+'>'+l+'</label>').join('')+'</div><label><input id=\"statRandom\" type=\"checkbox\">선택한 그룹(설비 또는 원료 LOT)을 더 큰 집단의 표본으로 보는 분산 분석 모형에 동의합니다 (%Contribution)</label><p><button id=\"statRun\" class=\"primary\">선택 분석 실행</button> <button id=\"statDownload\">결과 HTML 저장</button></p><p id=\"statError\" class=\"bad\" role=\"alert\"></p><div id=\"statResults\"></div>';document.querySelector('#out').prepend(panel);$('#statFrom').value=$('#from').value;$('#statTo').value=$('#to').value;$('#statFocus').value=$('#bid').value;const change=()=>{const series=catalogue[+$('#statY').value];$('#statEquipment').innerHTML='<option value=\"\">전체 설비</option>'+[...new Set(series.rows.map(r=>r.equipment))].map(v=>'<option>'+esc(v)+'</option>').join('');['statLSL','statUSL','statTarget','statBasis'].forEach(id=>$('#'+id).value='');$('#statResults').innerHTML='';result=null;};$('#statY').onchange=change;change();$('#statX').value=String(Math.max(0,catalogue.findIndex(s=>s.key.startsWith('Process:'))));$('#statRun').onclick=run;$('#statDownload').onclick=save;panel.addEventListener('input',e=>{if(e.target.id!=='statRun'){$('#statResults').innerHTML='';result=null;}});StatsVisual.setup(panel);panel.scrollIntoView({behavior:'smooth'});}catch(e){msg(e.message,'bad');}}\nfunction scatter(rows,reg){if(!rows.length)return '';const xs=rows.map(r=>r.x),ys=rows.map(r=>r.y),xmin=Math.min(...xs),xmax=Math.max(...xs),ymin=Math.min(...ys),ymax=Math.max(...ys),x=v=>60+(v-xmin)/(xmax-xmin||1)*660,y=v=>280-(v-ymin)/(ymax-ymin||1)*230;return '<svg viewBox=\"0 0 800 340\" role=\"img\" aria-label=\"X-Y 산점도\">'+[0,1,2,3,4].map(i=>{const yy=ymin+(ymax-ymin)*i/4,xx=xmin+(xmax-xmin)*i/4;return '<path d=\"M60 '+y(yy)+' H720 M'+x(xx)+' 50 V280\" stroke=\"#cdd5dc\" stroke-dasharray=\"3 4\"/><text x=\"5\" y=\"'+y(yy)+'\">'+display(yy)+'</text><text x=\"'+x(xx)+'\" y=\"310\">'+display(xx)+'</text>';}).join('')+rows.map(r=>'<circle cx=\"'+x(r.x)+'\" cy=\"'+y(r.y)+'\" r=\"4\" fill=\"#087f78\"><title>'+esc(r.id)+': X='+r.x+', Y='+r.y+'</title></circle>').join('')+'<text x=\"60\" y=\"335\">X 설명 인자 / Y 분석 특성 (단위는 선택 항목 참조)</text></svg>';}\nfunction run(){try{CMPReview.invalidate();$('#statError').textContent='';const s=catalogue[+$('#statY').value],xs=catalogue[+$('#statX').value],from=$('#statFrom').value,to=$('#statTo').value;if(from&&to&&from>to)throw Error('날짜 범위 오류');const rows=s.rows.filter(r=>(!$('#statEquipment').value||r.equipment===$('#statEquipment').value)&&(!from||r.time>=Date.parse(from+'T00:00:00+09:00'))&&(!to||r.time<Date.parse(to+'T00:00:00+09:00')+86400000));const lsl=number($('#statLSL').value),usl=number($('#statUSL').value),target=number($('#statTarget').value),k=+$('#statK').value,within=$('#statWithin').value,methods=[...document.querySelectorAll('[name=statMethod]:checked')].map(e=>e.value);if(!methods.length&&!document.querySelector('[name=statGraph]:checked'))throw Error('분석 항목 또는 그래프를 선택하세요.');if((lsl!=null||usl!=null)&&!$('#statBasis').value.trim())throw Error('규격 출처 / 개정을 입력하세요.');if(within==='mr'&&!$('#statAssume').checked)throw Error('군내 추정 적용성 검토를 체크하세요.');const c=CMPStats.capability(rows,{lsl,usl,k,within});let html='<h3>분석 결과 · '+rows.length+' Batch</h3><p>'+esc(s.label)+'</p><p>규격 출처: '+esc($('#statBasis').value||'미등록')+' · LSL '+display(lsl)+' / USL '+display(usl)+' · 목표값 '+display(target)+' · 범위 ±'+k+'σ · 군내 추정 '+esc(within)+'</p><p class=\"warn\">정규성·안정성·측정시스템은 자동 검증되지 않았습니다. 능력지수는 탐색용 추정치입니다.'+(rows.length<100?' 표본 100개 미만: 추정 불확실성에 유의하세요.':'')+'</p>'+grid(['n','평균','전체 s','군내 σ','규격 이탈 수','±'+k+'s 밖'],[[c.n,c.mean,c.overall,c.within,lsl==null&&usl==null?'규격 미등록':c.outside.length,c.signals.length]]);\nif(methods.includes('cap')){html+='<h3>표준 능력지수 (분모 3σ)</h3>'+grid(['Cp','Cpk','Cpu','Cpl','Pp','Ppk','Ppu','Ppl'],[[c.Cp,c.Cpk,c.Cpu,c.Cpl,c.Pp,c.Ppk,c.Ppu,c.Ppl]])+'<p>한쪽 규격만 있으면 Cpu/Cpl 또는 Ppu/Ppl만 표시합니다. 군내 추정 미지정·표준편차 0·규격 부족은 —로 표시합니다.</p>'+grid(['선택 배수 기반 상측 거리/(k·s)','하측 거리/(k·s)','평균−k·s','평균+k·s'],[[c.customUpper,c.customLower,c.lowerBand,c.upperBand]])+'<p>위 사용자 시그마 배수별 참고 지표는 표준 Cpk/Ppk가 아닙니다. 목표값은 규격이나 평균으로 대체하지 않습니다.</p>';if(within==='mr')html+='<p>I 관리도 3σ 단일점 신호 '+c.imrSignals.length+'건 (MR 기반, 같은 데이터로 한계 추정). 전체 관리도 규칙이나 안정성 검증 완료를 의미하지 않습니다.</p>';}\nif(methods.includes('dist')){const q=StatsVisual.summary(rows);html+='<h3>분포 요약</h3>'+grid(['n','최소','Q1','중앙값','Q3','최대','IQR'],[[q.n,q.min,q.q1,q.median,q.q3,q.max,q.iqr]]);}if(methods.includes('diag'))html+=StatsVisual.diagnostics(rows,c);\nhtml+=StatsVisual.render({rows,c,s,xs,target});\nif(methods.includes('xy')){try{const lookup=new Map(xs.rows.map(r=>[r.id,r.y])),pairs=rows.filter(r=>lookup.has(r.id)).map(r=>({...r,x:lookup.get(r.id)})),reg=CMPStats.regression(pairs);html+='<h3>X–Y 분석</h3><p>X: '+esc(xs.label)+'<br>Y: '+esc(s.label)+'</p><p>분석 가능한 X·Y 쌍 '+pairs.length+' / 선택 Y 데이터 '+rows.length+' · 제외 '+(rows.length-pairs.length)+'</p>'+grid(['Pearson r','Spearman ρ','회귀 R²','절편','기울기','잔차 RMSE'],[[reg.r,CMPStats.spearman(pairs),reg.r2,reg.intercept,reg.slope,reg.rmse]])+'<p>절편 포함 단순 선형 OLS: Y=절편+기울기×X. R²는 모형 설명력이며 원인 확률·분산성분 기여율이 아닙니다. 다른 요인의 영향, 원인과 결과의 시간차, 여러 항목을 동시에 비교할 때의 오판 가능성을 함께 검토합니다.</p><details><summary>회귀 잔차</summary>'+grid(['Batch_ID','X','Y','잔차'],reg.residuals.map(r=>[r.id,r.x,r.y,r.residual]))+'</details>';}catch(e){html+='<p class=\"warn\">X–Y: '+esc(e.message)+'</p>';}}\nconst factor=$('#statFactor')?.value||'',factorName=factor?factor+' 원료 LOT':'설비',lotOf=id=>{const m=((tables.Material&&tables.Material.rows)||[]).find(r=>r.Batch_ID===id&&r.Material_ID===factor);return m?m.Lot_ID:null;},grouped=rows.map(r=>({...r,group:factor?lotOf(r.id):r.equipment})).filter(r=>r.group);if(methods.includes('grp')){const g=new Map();for(const r of grouped){if(!g.has(r.group))g.set(r.group,[]);g.get(r.group).push(r);}const out=r=>(lsl!=null&&r.y<lsl)||(usl!=null&&r.y>usl);const table=[...g].map(([k,v])=>{const ys=v.map(r=>r.y),m=CMPStats.mean(ys),sd=ys.length>1?Math.sqrt(ys.reduce((a,y)=>a+(y-m)**2,0)/(ys.length-1)):null,o=v.filter(out).length;return{k,n:v.length,m,sd,max:Math.max(...ys),o,share:o/v.length};}).sort((a,b)=>b.o-a.o||b.share-a.share||Math.abs(b.m-c.mean)-Math.abs(a.m-c.mean));const flagged=table.filter(x=>x.o>0);html+='<h3>그룹 비교 · '+esc(factorName)+'</h3><p>규격 이탈이 있는 그룹을 위로 정렬합니다. 이탈 Batch가 한 그룹에 모두 모이고 그 그룹 안의 Batch가 대부분 이탈하면 강한 후보입니다. 반대로 같은 그룹에 정상 Batch가 함께 있으면 그 요인만으로는 설명되지 않습니다. 원료 LOT 교체 시점이 원료마다 엇갈려야 이 비교가 성립합니다.</p>'+(lsl==null&&usl==null?'<p class=\"warn\">규격을 입력하면 그룹별 이탈 수를 계산합니다.</p>':'<p>이탈이 있는 그룹 '+flagged.length+'개 / 전체 '+table.length+'개'+(flagged.length===1&&flagged[0].o===c.outside.length?' · <b>모든 이탈 Batch가 '+esc(flagged[0].k)+'에 집중</b>':'')+'</p>')+grid([factorName,'n','평균','표준편차','최대','규격 이탈','이탈 비율'],table.slice(0,12).map(x=>[x.k,x.n,x.m,x.sd,x.max,x.o,Math.round(x.share*100)+'%']))+(table.length>12?'<p class=\"muted\">상위 12개 그룹만 표시. 전체 '+table.length+'개.</p>':'')+'<p>그룹 비교는 원인 후보를 좁히는 단계이며 원인 확정이 아닙니다. 해당 원료 CoA·보관 이력·재시험으로 검증합니다.</p>';}if(methods.includes('vc')){try{if(!$('#statRandom').checked)throw Error('그룹을 더 큰 집단의 표본으로 보는 가정 확인이 필요합니다.');const v=CMPStats.contribution(grouped);html+='<h3>%Contribution · 1요인 '+esc(factorName)+' 랜덤효과</h3>'+grid(['그룹 수','그룹 간 분산','잔차 분산','그룹 기여율 %'],[[v.groups,v.between,v.residual,v.percent]])+'<p>분산분석(ANOVA) 기반 계산. 설비별 표본수 차이를 보정합니다. 음수로 추정된 분산은 0으로 처리'+(v.rawBetween<0?' (이번 결과에 적용)':'')+'. 원인 확률이 아닙니다. 설비 차이와 생산 시점·원료 차이가 함께 영향을 줄 수 있습니다.</p>';}catch(e){html+='<p class=\"warn\">%Contribution: '+esc(e.message)+'</p>';}}\nconst focus=rows.find(r=>r.id===$('#statFocus').value.trim());if($('#statFocus').value.trim())html+='<h3>관심 LOT</h3>'+(focus?grid(['Batch_ID','Y','평균 대비 차이','규격 이탈'],[[focus.id,focus.y,focus.y-c.mean,lsl==null&&usl==null?'판정 불가':c.outside.includes(focus)?'이탈':'규격 내']]):'<p>선택 조건에 관심 Batch가 없거나 유효값이 없습니다.</p>');html+='<details><summary>규격 이탈 Batch '+c.outside.length+'개</summary>'+grid(['Batch_ID','Y'],c.outside.map(r=>[r.id,r.y]))+'</details><details><summary>사용 데이터 / 제외 확인</summary><p>전체 Batch '+tables.Batch.rows.length+'개 중 이 Y 조건의 유효 기록 '+s.rows.length+'개, 날짜·설비 필터 후 '+rows.length+'개. 미측정·중복 최종값·미승인·조건 불일치는 통합하지 않습니다.</p>'+grid(['Batch_ID','설비','Y'],rows.map(r=>[r.id,r.equipment,r.y]))+'</details><p>작성: '+esc(new Date().toISOString())+' · 제작자: 김태양 · Ver1.0</p><p><a href=\"https://www.itl.nist.gov/div898/handbook/pmc/section1/pmc16.htm\">NIST 공정능력 정의</a> · <a href=\"https://www.itl.nist.gov/div898/handbook/pmc/section3/pmc322.htm\">NIST I-MR</a> · <a href=\"https://www.itl.nist.gov/div898/handbook/prc/section4/prc44.htm\">NIST 분산성분</a></p>';html=CMPReview.accept({rows,c,s,xs,target,methods})+html;result=html;$('#statResults').innerHTML=html;$('#statResults').style.overflow='auto';StatsVisual.wire();}catch(e){result=null;$('#statResults').innerHTML='';$('#statError').textContent=e.message;}}\nfunction save(){if(!result){$('#statError').textContent='먼저 분석을 실행하세요.';return;}const text='<!doctype html><meta charset=\"utf-8\"><title>LOT 통계 분석 Ver1.0</title><style>'+document.querySelector('style').textContent+'</style><main style=\"padding:24px\">'+result.replace(/<button class=\"save-figure\"[^>]*>[\\s\\S]*?<\\/button>/g,'')+'</main>',a=document.createElement('a'),url=URL.createObjectURL(new Blob([text],{type:'text/html;charset=utf-8'}));a.href=url;a.download='LOT_Statistics.html';a.click();setTimeout(()=>URL.revokeObjectURL(url),10000);}\nbutton.onclick=open;\nconst priorLoad=load;load=async function(files){await priorLoad(files);result=null;$('#statsPanel')?.remove();};\n})();\n</script><script>const SAMPLE240={\"Batch\":\"﻿\\\"Batch_ID\\\",\\\"Product_ID\\\",\\\"Recipe_Rev\\\",\\\"Site_ID\\\",\\\"Line_ID\\\",\\\"Equipment_ID\\\",\\\"Start_TS\\\",\\\"End_TS\\\",\\\"Disposition\\\",\\\"Ship_Status\\\",\\\"Ship_TS\\\",\\\"Data_Origin\\\",\\\"Reference_Eligible\\\"\\n\\\"SIM-S0001\\\",\\\"SIM-OX-02\\\",\\\"SIM-R02\\\",\\\"SITE-01\\\",\\\"LINE-1\\\",\\\"MIX-1\\\",\\\"2026-08-31T22:00:00Z\\\",\\\"2026-08-31T23:20:00Z\\\",\\\"RELEASED\\\",\\\"SHIPPED\\\",\\\"2026-09-03T23:20:00Z\\\",\\\"SYNTHETIC\\\",\\\"true\\\"\\n\\\"SIM-S0002\\\",\\\"SIM-OX-02\\\",\\\"SIM-R02\\\",\\\"SITE-01\\\",\\\"LINE-2\\\",\\\"MIX-2\\\",\\\"2026-08-31T22:00:00Z\\\",\\\"2026-08-31T23:20:00Z\\\",\\\"RELEASED\\\",\\\"SHIPPED\\\",\\\"2026-09-03T23:20:00Z\\\",\\\"SYNTHETIC\\\",\\\"true\\\"\\n\\\"SIM-S0003\\\",\\\"SIM-OX-02\\\",\\\"SIM-R02\\\",\\\"SITE-01\\\",\\\"LINE-3\\\",\\\"MIX-3\\\",\\\"2026-08-31T22:00:00Z\\\",\\\"2026-08-31T23:20:00Z\\\",\\\"RELEASED\\\",\\\"SHIPPED\\\",\\\"2026-09-03T23:20:00Z\\\",\\\"SYNTHETIC\\\",\\\"true\\\"\\n\\\"SIM-S0004\\\",\\\"SIM-OX-02\\\",\\\"SIM-R02\\\",\\\"SITE-01\\\",\\\"LINE-1\\\",\\\"MIX-1\\\",\\\"2026-08-31T23:30:00Z\\\",\\\"2026-09-01T00:50:00Z\\\",\\\"RELEASED\\\",\\\"SHIPPED\\\",\\\"2026-09-04T00:50:00Z\\\",\\\"SYNTHETIC\\\",\\\"true\\\"\\n\\\"SIM-S0005\\\",\\\"SIM-OX-02\\\",\\\"SIM-R02\\\",\\\"SITE-01\\\",\\\"LINE-2\\\",\\\"MIX-2\\\",\\\"2026-08-31T23:30:00Z\\\",\\\"2026-09-01T00:50:00Z\\\",\\\"RELEASED\\\",\\\"SHIPPED\\\",\\\"2026-09-04T00:50:00Z\\\",\\\"SYNTHETIC\\\",\\\"true\\\"\\n\\\"SIM-S0006\\\",\\\"SIM-OX-02\\\",\\\"SIM-R02\\\",\\\"SITE-01\\\",\\\"LINE-3\\\",\\\"MIX-3\\\",\\\"2026-08-31T23:30:00Z\\\",\\\"2026-09-01T00:50:00Z\\\",\\\"RELEASED\\\",\\\"SHIPPED\\\",\\\"2026-09-04T00:50:00Z\\\",\\\"SYNTHETIC\\\",\\\"true\\\"\\n\\\"SIM-S