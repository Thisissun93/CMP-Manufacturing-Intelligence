\\\"\\n\\\"SHIFT-6\\\",\\\"SITE\\\",\\\"SITE-01\\\",\\\"SHIFT_PRESTART\\\",\\\"2026-09-03T22:00:00Z\\\",\\\"2026-09-04T10:00:00Z\\\",\\\"2026-09-03T22:00:00Z\\\",\\\"PASS\\\",\\\"SYNTHETIC factory-wide 12-hour shift\\\",\\\"SYNTHETIC\\\"\\n\\\"SHIFT-7\\\",\\\"SITE\\\",\\\"SITE-01\\\",\\\"SHIFT_PRESTART\\\",\\\"2026-09-04T10:00:00Z\\\",\\\"2026-09-04T22:00:00Z\\\",\\\"2026-09-04T10:00:00Z\\\",\\\"PASS\\\",\\\"SYNTHETIC factory-wide 12-hour shift\\\",\\\"SYNTHETIC\\\"\\n\\\"SHIFT-8\\\",\\\"SITE\\\",\\\"SITE-01\\\",\\\"SHIFT_PRESTART\\\",\\\"2026-09-04T22:00:00Z\\\",\\\"2026-09-05T10:00:00Z\\\",\\\"2026-09-04T22:00:00Z\\\",\\\"PASS\\\",\\\"SYNTHETIC factory-wide 12-hour shift\\\",\\\"SYNTHETIC\\\"\\n\\\"SHIFT-9\\\",\\\"SITE\\\",\\\"SITE-01\\\",\\\"SHIFT_PRESTART\\\",\\\"2026-09-05T10:00:00Z\\\",\\\"2026-09-05T22:00:00Z\\\",\\\"2026-09-05T10:00:00Z\\\",\\\"PASS\\\",\\\"SYNTHETIC factory-wide 12-hour shift\\\",\\\"SYNTHETIC\\\"\"};const demo240=document.createElement(\"button\");demo240.id=\"demo240\";demo240.textContent=\"통계용 240 Batch 불러오기\";document.querySelector(\"#demo\").parentElement.append(demo240);demo240.onclick=async()=>{await load(Object.entries(SAMPLE240).map(([k,v])=>new File([v],k+\".csv\",{type:\"text/csv\"})));document.querySelector(\"#bid\").value=\"SIM-S0240\";};</script><script>const reportPrevious=document.querySelector(\"#report\").onclick;document.querySelector(\"#report\").onclick=function(e){msg(\"\");reportPrevious.call(this,e);if(document.querySelector(\"#status\").classList.contains(\"bad\")){document.querySelector(\"#out\").innerHTML=\"\";}else{msg(\"보고서를 생성했습니다. 옆의 2단계 LOT 통계 분석에서 이어서 분석할 수 있습니다.\");}};</script><script>(function(){\n// Add a save control to standalone, editable documents downloaded from the app.\nwindow.editableDocument=function(html){const script='const save=document.createElement(\"button\");save.textContent=\"수정본 HTML 저장\";save.id=\"editableSave\";document.body.prepend(save);save.onclick=()=>{const clone=document.documentElement.cloneNode(true);clone.querySelector(\"#editableSave\")?.remove();const url=URL.createObjectURL(new Blob([\"<!doctype html>\"+clone.outerHTML],{type:\"text/html;charset=utf-8\"}));const a=document.createElement(\"a\");a.href=url;a.download=\"Engineer_Review_Edited.html\";a.click();setTimeout(()=>URL.revokeObjectURL(url),10000);};';return html.replace('</body>','<script>'+script+'<'+ '/script></body>');};\n})();\n</script><script>(function(root){\nconst sources={\n E1:{title:'Entegris · CMP Filter Characterization with Leading Slurry Particles',url:'https://www.entegris.com/content/dam/product-assets/planargardnmbfilter/appnote-cmp-slurry-particles-7561.pdf',fact:'pH 변화·전단·온도는 연마입자 응집에 영향을 줄 수 있으며, 큰 입자는 스크래치와 관련된다.'},\n M1:{title:'Malvern Panalytical · SiO₂ slurry characterization',url:'https://www.malvernpanalytical.com/tw/learn/knowledge-center/application-notes/an101104characterizationofsio2',fact:'입도와 제타전위는 슬러리 특성 평가에 사용되며, 적절한 pH 범위는 제품별로 확인해야 한다.'},\n M2:{title:'Malvern Panalytical · Highly concentrated CMP slurry dispersions',url:'https://www.malvernpanalytical.com.cn/learn/knowledge-center/application-notes/an101104highlyconcentratedcmpslurry',fact:'제타전위는 pH·염 농도·표면 흡착과 측정 시 희석 조건의 영향을 받는다.'},\n P1:{title:'Pall · CMPure CMPD filter data sheet E89a',url:'https://www.pall.com/content/dam/pall/oil-gas/literature-library/non-gated/E89.pdf',fact:'필터에는 제품과 온도 조건별 최대 차압 등 사용 조건이 정해져 있다. 특정 필터 사양을 전체 슬러리의 한계로 적용할 수 없다.'},\n E2:{title:'Entegris · CMP slurry concentration monitoring',url:'https://www.entegris.com/content/dam/product-assets/invuegv148concentrationmonitors/appnote-cmp-slurry-hydrogen-peroxide-concentration-monitoring-14264.pdf',fact:'슬러리 및 DI water 투입으로 농도가 변하며, 농도 센서의 온도·유동 조건을 함께 평가한다.'},\n E3:{title:'Entegris · CMP Process Monitoring',url:'https://www.entegris.com/en/home/resources/industry-insights/cmp-process-monitoring.html',fact:'사용 중 슬러리 조성 변화가 생길 수 있어 제조부터 사용 지점까지 특성을 확인한다.'},\n A1:{title:'Agilent · Semiconductor Industry Solutions',url:'https://www.agilent.com/cs/library/brochures/5994-4747EN_Agilent%20Semiconductor%20Industry%20Solutions.pdf',fact:'CMP 슬러리를 포함한 반도체 재료의 미량 금속 오염 관리와 분석이 필요하다.'},\n E4:{title:'Entegris · Improving yield rates on existing CMP tools',url:'https://www.entegris.com/content/dam/shared-product-assets/sensing-and-control/article-improving-yield-rates-on-existing-cmp-tools-1910.pdf',fact:'보고된 CMP 공급 사례에서 펌프 응답과 유량 감지가 공급 부족에 관련되었으며, 기포·공급압 변화가 계측에 영향을 주었다.'}\n};\nconst cases=[\n{id:'PARTICLE',name:'큰 입자 수 증가 / 입도 분포 변화',pattern:'LPC|D90|D50|입도|큰 입자',sources:['E1','M1'],failure:'응집 입자 증가',effect:'입자성 스크래치 위험 증가',cause:'pH·온도·전단 이력 또는 여과 조건 변화. 현재 LOT에서는 미확인.',check:'동일 시료의 LPC와 PSD를 같은 희석법으로 재확인하고, 필터 전후·원료/완제품 시료를 비교한다.',action:'승인된 조건에서 필터 적합성과 혼합/이송 조건을 비교 시험한다. 필터 등급을 임의로 미세화하거나 재여과만으로 출하하지 않는다.',monitor:'LPC, D50/D90, pH, 온도, 필터 전후 데이터',frequency:'Batch 최종 QC 및 필터/이송조건 변경 전후',accept:'제품별 승인 LPC·PSD 규격과 유효한 비교시험 계획. 입자 감소와 함께 정상 작업입도 보존 확인.'},\n{id:'PH',name:'pH 규격 이탈',pattern:'pH|산도',sources:['E1','M1'],failure:'제품 화학조건 이탈',effect:'분산상태·연마 특성 변동 가능',cause:'첨가/희석 비율 또는 계측 조건의 차이. 원인 분리는 확인시험이 필요하다.',check:'pH 계측기 교정·시료 온도·채취 위치를 확인하고 투입량/순서를 원본과 대조한다.',action:'투입 또는 계측 원인이 확인되면 승인된 조제·교정 절차를 수정한다. 재작업은 품질 승인과 재검증 후 수행한다.',monitor:'pH, 측정 온도, 첨가량, LPC/PSD',frequency:'Batch 조제 완료 및 최종 QC',accept:'제품별 승인 pH 규격 충족과 입자 특성 유지. 본문 수치를 다른 제품에 전용하지 않음.'},\n{id:'ZETA',name:'제타전위 변화 / 분산안정성 확인',pattern:'Zeta|제타',sources:['M2'],failure:'분산안정성 변화 또는 시험 조건 불일치',effect:'응집·보관안정성 평가 결과 변화',cause:'pH·이온 환경·표면 상태 또는 희석법 차이.',check:'동일 pH·전도도·희석액·희석배수·온도로 측정 조건을 맞추고 반복 측정한다.',action:'측정 조건 차이인지 제품 변화인지 분리한다. 제품 변화가 확인되면 승인된 조성/혼합 조건의 비교시험을 수행한다.',monitor:'제타전위, 시험 pH, 전도도, 희석 조건, 시간 경과별 입도',frequency:'Batch QC 및 원료/희석법 변경 시',accept:'제품·시험법별 등록 규격과 보관안정성 검증 기준. 모든 제품에 일률적인 mV 기준을 사용하지 않음.'},\n{id:'CONCENTRATION',name:'고형분 / 희석 농도 이탈',pattern:'Solids|고형분|농도|투입량',sources:['E2'],failure:'조제 농도 불일치',effect:'제품 특성과 공급 일관성 변화',cause:'원액/DI water 투입량 또는 농도 측정 조건의 차이.',check:'질량수지·저울·유량계와 농도 센서 교정/온도 보정을 확인한다. 기준 시험법과 대조한다.',action:'확인된 계량/제어 문제를 수정하고 기준 시험법으로 농도와 관련 QC를 재검증한다.',monitor:'고형분 또는 승인 농도 시험, 원액/DIW 질량, 온도',frequency:'Batch 조제 완료 및 희석/설비 조건 변경 후',accept:'승인 농도 범위와 질량수지 허용오차. 센서값만으로 적합 판정하지 않음.'},\n{id:'FILTER',name:'여과 차압 상승',pattern:'Filter_DP|차압',sources:['P1','E1'],failure:'여과 저항 증가 또는 차압 측정 이상',effect:'처리량 감소·필터 사용 조건 초과 위험',cause:'필터 부하·유량·슬러리 상태 또는 압력 계측의 영향 (점검 가설).',check:'같은 유량·온도에서 전후압과 필터 사용량을 비교하고 압력 센서·밸브 상태 및 장착 모델을 확인한다.',action:'제품별 필터 사용 조건과 승인 교체 기준에 따라 대응한다. 교체 시 초기 세정/적합성 확인 후 전후 LPC·PSD를 비교한다.',monitor:'차압, 유량, 온도, 필터 누적 사용량, 전후 LPC',frequency:'여과 중 추세 및 필터 교체 전후',accept:'등록 필터 모델의 온도별 허용조건과 현장 교체 기준. 80 kPa는 현재 시연 규칙일 뿐 문헌 공통 기준이 아님.'},\n{id:'THERMAL',name:'혼합 온도 / 전단조건 변화',pattern:'온도|Temperature|RPM|회전수',sources:['E1'],failure:'입자에 가해지는 열·기계적 조건 변화',effect:'응집 및 입도 꼬리 분포 변화 가능',cause:'온도와 전단 영향은 슬러리 종류 및 장치 조건에 따라 달라진다.',check:'설정값/실제값, 온도 센서, 냉각 상태, 펌프·교반기 운전 이력을 확인한다.',action:'확인된 제어 이상을 복구하고 승인된 운전 범위 내 비교시험으로 LPC/PSD와 성능을 확인한다.',monitor:'최대·평균 온도, 회전수, 이송 횟수, LPC/PSD',frequency:'혼합·순환 중 기록 및 운전조건 변경 후',accept:'제품 처방의 승인 운전범위와 제품 QC. RPM 또는 온도 숫자를 문헌에서 가져와 바로 적용하지 않음.'},\n{id:'HOLD',name:'대기 / 보관 / 순환 시간 증가',pattern:'대기|Hold|보관|순환',sources:['E3'],failure:'시간 경과에 따른 조성·특성 변화',effect:'제조 직후 결과와 사용 시점 품질의 차이',cause:'시간 경과에 따른 변화 가능성. 실제 변화 방향·속도는 제품별 확인 대상.',check:'보관 온도·밀폐 상태·순환 이력과 시간대별 농도·입자·pH를 대조한다.',action:'승인 보관시간·취급 조건을 재검토하고 시간대별 안정성 시험으로 관리범위를 설정한다.',monitor:'대기시간, 보관온도, 농도, pH, LPC/PSD',frequency:'대기 시작·종료 및 안정성 시험계획의 측정 시점',accept:'제품별 검증된 보관/사용시간과 종료 시점 QC. 60분 시연 기준을 실제 허용시간으로 전용하지 않음.'},\n{id:'METAL',name:'미량 금속 분석값 상승',pattern:'Fe|금속',sources:['A1'],failure:'금속 분석값 또는 오염 관리 이상',effect:'불순물 규격 이탈 가능',cause:'시료·용기·시험과정 또는 원료/접액부 영향은 각각 확인할 후보이며 본 자료만으로 특정하지 않는다.',check:'시험 공시험·표준물질·회수율·정량한계 및 시료 용기를 검토하고 원료/공정 단계별 시료를 승인 방법으로 분석한다.',action:'분석 오류와 공정 기원을 구분한 뒤 확인된 원료 또는 접액부 관리항목을 수정한다.',monitor:'제품별 관리 금속, 공시험, 시험법, 원료/용기 이력',frequency:'제품 QC 및 원료·접액부 변경 검증',accept:'제품별 승인 금속 규격과 유효한 시험 품질관리 기준. 성분으로 의도 첨가한 금속과 오염을 구분.'},\n{id:'FLOW',name:'슬러리 유량 부족 / 공급 변동',pattern:'유량|Flow',sources:['E4'],failure:'공급 응답 지연 또는 감지 불량',effect:'요구 공급량 부족 가능',cause:'펌프 응답·압력·기포의 영향은 문헌 사례에 보고되었다. 해당 장치에 동일 원인이 있는지는 별도 확인한다.',check:'설정/실제 유량·공급압·펌프 응답을 시간 동기화하여 확인하고 계측기 적합성을 점검한다.',action:'확인된 제어·계측 문제를 수정하고 시작/정상 운전 구간의 유량 응답을 재검증한다.',monitor:'유량, 압력, 시작 응답시간, 알람 기록',frequency:'공급 시작·정상 운전 및 펌프/계측 변경 후',accept:'해당 설비의 승인 유량·응답 기준. 문헌 장치의 수치를 다른 장치에 적용하지 않음.'}\n];\nfunction matches(c,report){return report.findings.filter(f=>['oos','review','signal','integrity'].includes(f.kind)&&new RegExp(c.pattern,'i').test(f.title+' '+f.detail));}\nfunction documents(){return cases.flatMap(c=>['OCAP','FMEA','CP'].map(type=>({id:type+'-REF-'+c.id,type:type==='CP'?'Control Plan':type,rev:'REF-1',trigger:c.name,owner:'공정 엔지니어 / 품질 담당자',action:type==='OCAP'?c.check+' '+c.action:type==='FMEA'?'고장형태: '+c.failure+' / 영향: '+c.effect+' / 원인 후보: '+c.cause:c.monitor+' / 수집 시점: '+c.frequency,result:type==='FMEA'?'기존 예방·검출 통제, 확인시험 결과, 변경 전후 위험도 평가 근거 (S/O/D는 평가팀 입력)':c.accept,kb:c.id,evidence:c.sources.map(id=>({id,...sources[id]})),verification:c.check,control:c.monitor,frequency:c.frequency,criterion:c.accept,sourceScope:'문헌의 현상 설명과 본 프로그램의 점검·조치 제안을 구분합니다. 승인 여부와 현재 LOT 원인 확정은 별도 검토 대상입니다.'})));}\nroot.CMPKnowledge={sources,cases,matches,documents};if(typeof module!=='undefined')module.exports=root.CMPKnowledge;\n})(globalThis);\n</script><script>(function(){\nconst standards=[\n{id:'OCAP-DEMO-01',type:'OCAP',rev:'EXAMPLE-1',trigger:'규격 이탈 또는 공정 상한 초과',action:'원본·단위·규격 개정을 확인하고 영향 LOT의 식별 및 보류 여부를 품질 담당자에게 검토 요청한다. 승인된 절차에 따라 설비/원료/계측 이력을 확인한다. 재시험으로 최초 이탈 기록을 지우지 않는다.',result:'영향 LOT 목록, 원본 시험기록, 계측 확인, 처분 승인 근거',owner:'공정 엔지니어 / 품질 담당자'},\n{id:'OCAP-DEMO-02',type:'OCAP',rev:'EXAMPLE-1',trigger:'기록 누락·연결 오류',action:'동일 Batch와 시간 범위로 원본 시스템을 재조회한다. 설비·시험법·유효시간을 대조하고 누락과 실제 미수행을 구분한다.',result:'재추출 범위, 확보 기록, 미확보 사유, 판단 제한',owner:'데이터 담당 / 공정 엔지니어'},\n{id:'OCAP-DEMO-03',type:'OCAP',rev:'EXAMPLE-1',trigger:'통계 변화 또는 등록 능력 기준 미달',action:'측정시스템·시간순 안정성·설비·원료 등 다른 요인의 영향을 검토한다. 근거가 있는 원인 가설별 확인 시험을 설계하고 승인 후 수행한다.',result:'가설, 지지·반증 자료, 확인시험 계획, 실시 결과',owner:'공정 엔지니어 / 품질 담당자'},\n{id:'FMEA-DEMO-01',type:'FMEA',rev:'EXAMPLE-1',trigger:'혼합·여과·QC 이상 검토',action:'잠재 고장 형태: 혼합조건 이탈 또는 여과 저항 증가. 잠재 영향: 제품 특성 변동. 잠재 원인: 설정·필터 상태·측정 오류 등 미검증 가설. 현재 예방/검출 통제를 대조하고 평가팀이 위험도를 결정한다.',result:'고장 형태·영향·원인 가설, 현재 통제, 증거, 개선안, S/O/D 평가 근거 (미평가 값은 비워둠)',owner:'다기능 FMEA 검토팀'},\n{id:'CP-DEMO-01',type:'Control Plan',rev:'EXAMPLE-1',trigger:'조치 후 검증 및 지속 수집',action:'제품·특성·단위·시험법·규격 개정별 측정 계획을 등록한다. Batch별 QC 최종값과 설비/교대 점검을 수집한다. 관찰기간·표본수·판정 기준을 사전 합의하고 동일 조건으로 전후 결과를 검토한다.',result:'수집 범위, 측정 책임자, 빈도, 반응계획, 전후 데이터, 효과성 판정과 검토자',owner:'공정 엔지니어 / 품질 담당자'}];\nstandards.push(...CMPKnowledge.documents());\nlet snapshot=null;const key='cmp-review-cases-v1';let cases=[];try{cases=JSON.parse(localStorage.getItem(key)||'[]');if(!Array.isArray(cases))cases=[];}catch{}\nconst safe=v=>esc(v),num=v=>Number.isFinite(v)?display(v):'계산 불가';\nfunction invalidate(){snapshot=null;document.querySelector('#rcaPanel')?.remove();}\nfunction summaries(s){const lines=[],c=s.c;lines.push(`분석 조건의 유효 Batch ${c.n}개, Y 평균 ${num(c.mean)}, 전체 표준편차 ${num(c.overall)}입니다.`);if(c.lsl!=null||c.usl!=null)lines.push(`등록 규격(${s.basis}) 대비 ${c.outside.length}/${c.n}개 Batch가 이탈했습니다. 이는 선택한 분석 집단의 결과입니다.`);\nif(s.methods.includes('cap')){for(const metric of ['Cpk','Ppk']){if(Number.isFinite(c[metric]))lines.push(s.threshold!=null?`${metric}=${num(c[metric])}, 사용자 등록 기준 ${num(s.threshold)}(${s.thresholdBasis})에 ${c[metric]<s.threshold?'미달':'이상'}입니다. 분포·안정성 미검증 상태의 탐색 추정치입니다.`:`${metric}=${num(c[metric])}입니다. 내부 관리 기준 미등록으로 충족 여부는 판정하지 않았습니다.`);}}\nif(s.reg)lines.push(`X–Y 분석 가능한 X·Y 쌍 ${s.reg.n}개, R²=${num(s.reg.r2)}입니다. 이 표본의 선형 모형 설명력이며 불량 원인일 확률이나 직접 기여의 증거가 아닙니다. 다른 요인의 영향과 예측 오차를 검토한 후 확인시험이 필요합니다.`);\nconst eq=[...new Set(s.rows.map(r=>r.equipment))].map(id=>{const rs=s.rows.filter(r=>r.equipment===id),fail=rs.filter(r=>(c.lsl!=null&&r.y<c.lsl)||(c.usl!=null&&r.y>c.usl)).length;return{id,n:rs.length,fail,sd:CMPStats.sd(rs.map(r=>r.y))};});\nif(eq.length>1&&(c.lsl!=null||c.usl!=null)){const sorted=[...eq].sort((a,b)=>b.fail/b.n-a.fail/a.n);if(sorted[0].fail&&sorted[0].fail/sorted[0].n>sorted[1].fail/sorted[1].n)lines.push(`${sorted[0].id}의 관측 이탈률이 비교 설비 중 가장 높습니다 (${sorted[0].fail}/${sorted[0].n}). 표본수·생산시점·원료 조건을 대조한 뒤 해당 설비의 점검 이력을 우선 확인하도록 권장합니다. 설비 원인으로 확정하지 않습니다.`);}\nreturn lines;}\nfunction accept(ctx){const threshold=number(document.querySelector('#reviewThreshold')?.value),thresholdBasis=document.querySelector('#reviewThresholdBasis')?.value.trim()||'';if(threshold!=null&&(!(threshold>0)||!thresholdBasis))throw Error('능력 기준을 입력하면 양수와 기준 근거를 함께 등록하세요.');const lookup=new Map(ctx.xs.rows.map(r=>[r.id,r.y]));let reg=null;if(ctx.methods.includes('xy'))try{reg=CMPStats.regression(ctx.rows.filter(r=>lookup.has(r.id)).map(r=>({...r,x:lookup.get(r.id)})));}catch{}\n snapshot={...ctx,label:ctx.s.label,xLabel:ctx.xs.label,basis:$('#statBasis').value,threshold,thresholdBasis,reg,created:new Date().toISOString(),sourceFiles:Object.fromEntries(V2.kinds.map(k=>[k,{name:tables[k].filename,rows:tables[k].rows.length}])),sources:ctx.rows.map(r=>({batch:r.id,records:['Batch','QC','Process'].flatMap(k=>(tables[k].byBatch[r.id]||[]).map(x=>({table:k,file:x._file,line:x._line,record:x}))) }))};snapshot.summary=summaries(snapshot);return '<section id=\"evidenceSummary\"><h3>근거 기반 요약 및 검토 의견</h3><ul>'+snapshot.summary.map(t=>'<li>'+safe(t)+'</li>').join('')+'</ul><p class=\"muted\">규칙 기반 문장 생성 · 원인 확정/자동 출하 판정 없음. 분석 조건을 변경하면 이 요약은 무효화됩니다.</p></section>';}\nconst setupBefore=StatsVisual.setup;StatsVisual.setup=function(panel){setupBefore(panel);const block=document.createElement('div');block.className='row';block.innerHTML='<label>내부 Cpk/Ppk 최소 기준 (선택)<input id=\"reviewThreshold\" type=\"number\" min=\"0\" step=\"any\" placeholder=\"미등록 시 충족 여부 판정 안 함\"></label><label>내부 기준 근거<input id=\"reviewThresholdBasis\" placeholder=\"예: 사내 기준 CP-01 Rev.2\"></label>';panel.querySelector('#statRun').parentElement.before(block);panel.addEventListener('input',invalidate);};\nfunction docHTML(doc){return '<h2>'+safe(doc.type)+' 예시 '+safe(doc.id)+'</h2><p>개정 '+doc.rev+'</p>'+grid(['항목','내용'],[['적용 신호',doc.trigger],['제안 조치',doc.action],['요구 결과/증거',doc.result],['담당 역할',doc.owner],...(doc.kb?[[\"확인시험\",doc.verification],[\"관리 특성\",doc.control],[\"수집 시점\",doc.frequency],[\"판정 기준\",doc.criterion],[\"문헌 해석 범위\",doc.sourceScope]]:[]),['적용 조건','현장 승인 절차·규격·책임자 확인 후 사용. 자동 조작·출하 승인 없음.']])+(doc.evidence?'<h4>근거 자료</h4>'+doc.evidence.map(e=>'<p><a href=\"'+safe(e.url)+'\" target=\"_blank\" rel=\"noopener\">'+safe(e.title)+'</a><br>'+safe(e.fact)+'</p>').join(''):'');}\nfunction download(name,text,type='text/html;charset=utf-8'){const a=document.createElement('a'),url=URL.createObjectURL(new Blob([type.startsWith('text/html')?editableDocument(text):text],{type}));a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),10000);}\nfunction wrap(title,body){return '<!doctype html><html lang=\"ko\"><meta charset=\"utf-8\"><title>'+safe(title)+'</title><style>body{font:15px Malgun Gothic,sans-serif;max-width:1050px;margin:30px auto;line-height:1.7}table{border-collapse:collapse;width:100%}td,th{border:1px solid #ccd5dc;padding:10px;text-align:left}h1,h2{color:#163449}textarea{width:100%}</style><body>'+body+'</body></html>';}\nfunction open(){try{ensure();const bid=$('#bid').value.trim(),r=analyze(bid);let linked=snapshot?.rows.some(x=>x.id===bid)?snapshot:null;const findings=r.findings,ids=new Set();if(findings.some(f=>f.kind==='oos'||(f.kind==='review'&&/초과|온도 검토|차압 검토|대기시간 연장/.test(f.title))))ids.add('OCAP-DEMO-01');if(findings.some(f=>f.kind==='missing'||f.kind==='integrity'))ids.add('OCAP-DEMO-02');if(findings.some(f=>f.kind==='signal'||f.kind==='change')||(linked&&(linked.c.signals.length||linked.c.outside.length||linked.threshold!=null&&['Cpk','Ppk'].some(k=>Number.isFinite(linked.c[k])&&linked.c[k]<linked.threshold))))ids.add('OCAP-DEMO-03');if(ids.has('OCAP-DEMO-01')||ids.has('OCAP-DEMO-03'))ids.add('FMEA-DEMO-01');if(ids.size)ids.add('CP-DEMO-01');for(const c of CMPKnowledge.cases)if(CMPKnowledge.matches(c,r).length)for(const type of ['OCAP','FMEA','CP'])ids.add(type+'-REF-'+c.id);const matched=standards.filter(s=>ids.has(s.id));\ndocument.querySelector('#rcaPanel')?.remove();const panel=document.createElement('section');panel.id='rcaPanel';panel.innerHTML='<h2>3단계 · RCA 지원 / 4단계 · 검증과 지속 수집</h2><p>대상 Batch: <b>'+safe(bid)+'</b> · 원인·조치 결과는 엔지니어 검토 전 미확정입니다.</p>'+(snapshot&&!linked?'<p>현재 통계 집단에 이 Batch가 없어 통계 결과를 초안에서 제외합니다.</p>':'')+'<h3>적용 문서 · 조치 및 확인 결과</h3><p>문서 연결은 현재 Batch의 신호와 연결된 통계 집단 신호에 대한 예시 규칙입니다. 집단의 이탈이나 능력 부족을 이 Batch의 불량 원인으로 간주하지 않습니다.</p>'+(matched.length?matched.map(s=>'<details open><summary>'+safe(s.id)+' · '+safe(s.type)+'</summary>'+docHTML(s)+'</details>').join(''):'<p>등록된 규칙에서 적용 신호가 없어 조치를 생성하지 않았습니다.</p>')+'<details><summary>예시 표준문서 전체 보기 / 다운로드</summary>'+standards.map((s,i)=>docHTML(s)+'<button data-standard=\"'+i+'\">편집용 예시 HTML 저장</button>').join('')+'</details><h3>검증 기록 (사용자 입력)</h3><div class=\"row\"><label>담당자<input id=\"rcaOwner\"></label><label>검증 기한<input id=\"rcaDue\" type=\"date\"></label><label>상태<select id=\"rcaState\"><option>제안</option><option>진행 중</option><option>검증 완료</option></select></label></div><label>원인 가설 / 원인을 지지하거나 배제할 자료와 확인시험<textarea id=\"rcaHypothesis\" rows=\"3\"></textarea></label><label>실제 실시 조치 및 결과<textarea id=\"rcaResult\" rows=\"3\"></textarea></label><label>증거 문서 번호·측정 결과·검토자<textarea id=\"rcaEvidence\" rows=\"3\"></textarea></label><label>지속 수집 계획 (특성·빈도·기간·표본수·효과성 기준)<textarea id=\"rcaPlan\" rows=\"3\"></textarea></label><p><button id=\"rcaSave\">검증 기록과 근거 분석 시점 기록 저장</button> <button id=\"rcaDraft\">엔지니어 검토 초안 생성</button> <button id=\"rcaHistory\">지속 수집 이력 내보내기</button></p><p id=\"rcaMessage\" role=\"status\"></p><p>이 브라우저의 저장 이력 <span id=\"reviewCount\">'+cases.length+'</span>건. CSV 재조회 후 2단계 분석과 검증 기록을 다시 저장하면 새 시점의 이력을 누적합니다. MES/SPC 자동 연결은 아직 없으며 브라우저 저장 삭제에 대비해 이력을 내보내세요.</p><div id=\"draftArea\"></div>';$('#out').prepend(panel);panel.querySelectorAll('[data-standard]').forEach(b=>b.onclick=()=>download(standards[+b.dataset.standard].id+'.html',wrap('예시 표준', '<main contenteditable=\"true\">'+docHTML(standards[+b.dataset.standard])+'</main>')));\nconst input=()=>({owner:$('#rcaOwner').value.trim(),due:$('#rcaDue').value,state:$('#rcaState').value,hypothesis:$('#rcaHypothesis').value.trim(),result:$('#rcaResult').value.trim(),evidence:$('#rcaEvidence').value.trim(),plan:$('#rcaPlan').value.trim()});\nconst base=()=>({format:'CMP-REVIEW-1',id:crypto.randomUUID(),saved:new Date().toISOString(),bid,report:r,analysis:linked,standards:matched.map(s=>({...s})),user:input()});\n$('#rcaSave').onclick=()=>{try{const entry=base();if(entry.user.state==='검증 완료'&&(!entry.user.owner||!entry.user.result||!entry.user.evidence))throw Error('검증 완료에는 담당자·실시 결과·증거/검토자가 필요합니다.');const next=[...cases,entry];localStorage.setItem(key,JSON.stringify(next));cases=next;document.querySelector('#reviewCount').textContent=cases.length;$('#rcaMessage').textContent='저장 완료 · '+cases.length+'건. 검증 상태는 사용자 입력이며 프로그램이 효과성을 인증하지 않습니다.';}catch(e){$('#rcaMessage').textContent='저장 실패: '+e.message;}};\n$('#rcaHistory').onclick=()=>download('CMP_Review_History.json',JSON.stringify(cases,null,2),'application/json');\n$('#rcaDraft').onclick=()=>{const e=base(),u=e.user;if(u.state==='검증 완료'&&(!u.owner||!u.result||!u.evidence)){document.querySelector(\"#rcaMessage\").textContent='검증 완료에는 담당자·실시 결과·증거/검토자가 필요합니다.';return;}let body='<h1>제조 이력 및 RCA 엔지니어 검토 초안</h1><p>Batch '+safe(bid)+' · '+safe(e.saved)+' · 작성 지원: 김태양 · Ver1.0 · 엔지니어 승인 전 초안</p><h2>제조 이력에서 확인한 사실</h2>'+grid(['제품','처방','설비','시작','종료'],[[r.b.Product_ID,r.b.Recipe_Rev,r.b.Equipment_ID,r.b.Start_TS,r.b.End_TS]]);if(findings.length)body+=grid(['확인 신호','근거','원본 위치'],findings.map(f=>[f.title,f.detail,(f.sources||[]).join('; ')]));if(linked)body+='<h2>통계 요약 및 검토 의견</h2><p>Y: '+safe(linked.label)+' / X: '+safe(linked.xLabel)+'</p><p>규격: '+safe(linked.basis||'미등록')+' / LSL '+num(linked.c.lsl)+' / USL '+num(linked.c.usl)+' / 내부 기준 '+num(linked.threshold)+' '+safe(linked.thresholdBasis)+'</p><ul>'+linked.summary.map(t=>'<li>'+safe(t)+'</li>').join('')+'<details><summary>통계에 사용한 Batch 및 원본 위치</summary>'+grid(['Batch','출처'],linked.sources.map(s=>[s.batch,s.records.map(x=>x.file+':'+x.line).join('; ')]))+'</details>';if(matched.length)body+='<h2>제안 조치와 요구 증거</h2>'+grid(['예시 문서 / 개정','제안 조치','필요한 결과·증거'],matched.map(s=>[s.id+' / '+s.rev,s.action,s.result]));for(const[k,title]of [['hypothesis','사용자 입력 원인 가설 및 확인시험'],['result','사용자 입력 실시 조치와 결과'],['evidence','사용자 입력 증거 및 검토자'],['plan','지속 수집 및 효과성 확인 계획']])if(u[k])body+='<h2>'+title+'</h2><p>'+safe(u[k]).replaceAll('\\n','<br>')+'</p>';if(u.owner)body+='<p>담당자: '+safe(u.owner)+(u.due?' · 기한: '+safe(u.due):'')+'</p>';body+='<p>조치 상태 (사용자 입력): '+safe(u.state)+'</p>';$('#draftArea').innerHTML='<h3>검토 초안 편집</h3><p>아래 내용을 직접 수정한 뒤 저장하세요. 자동 생성 근거와 사용자 수정본은 검증 기록 분석 시점 기록과 별도로 관리됩니다.</p><div id=\"draftEditor\" contenteditable=\"true\" style=\"border:1px solid #9babb8;padding:16px;background:white\">'+body+'</div><p><button id=\"draftExport\">편집 가능한 HTML 문서 저장</button></p>';$('#draftExport').onclick=()=>download('Engineer_Review_'+bid.replace(/[^a-z0-9_-]/gi,'_')+'.html',wrap('엔지니어 검토 초안','<p>이 문서는 브라우저에서 본문을 편집할 수 있습니다. 편집 후 상단 수정본 HTML 저장 버튼을 누르세요.</p><main contenteditable=\"true\">'+$('#draftEditor').innerHTML+'</main>'));};panel.scrollIntoView({behavior:'smooth'});\n}catch(e){msg(e.message,'bad');}}\nconst button=document.createElement('button');button.id='rcaOpen';button.textContent='3단계 · RCA / 검증';$('#report').parentElement.append(button);button.onclick=open;\nconst oldLoad=load;load=async function(files){invalidate();await oldLoad(files);};const oldClear=$('#clear').onclick;$('#clear').onclick=()=>{invalidate();oldClear();};\nwindow.CMPReview={accept,invalidate,standards,getCases:()=>JSON.parse(JSON.stringify(cases)),mergeCases:incoming=>{const next=[...cases];for(const e of incoming){const old=next.find(x=>x.id===e.id);if(old&&JSON.stringify(old)!==JSON.stringify(e))throw Error('동일 기록 ID의 내용이 다릅니다. 복원을 중단했습니다.');if(!old)next.push(e);}localStorage.setItem(key,JSON.stringify(next));cases=next;invalidate();return cases.length;}};\n})();\n</script></html>\n<script>// 4단계 · 영향 범위 / CAPA\n// 1~3단계가 \"왜 이탈했나\"에서 끝나므로, 그 다음 두 질문을 담당한다.\n//  (1) 영향 범위 — 의심 원료 LOT으로 만든 Batch 전수와 출하 상태. 방향이 반대(원료 → Batch).\n//      QC를 통과했지만 규격 여유가 적은 Batch를 따로 분류한다. 실제 품질 사고는 여기서 난다.\n//  (2) CAPA — 봉쇄부터 종결까지. 효과성 검증은 손으로 적는 대신 데이터로 판정한다.\n(function(){\n const NEAR=0.05;            // 규격 여유가 이 비율 미만이면 '규격 내 주의'\n const EFF_WINDOW=20;        // 효과성 검증 구간 Batch 수\n const PPK_TARGET=1.33;      // 효과성 검증 통과 기준\n const el=(t,a={},...c)=>{const n=document.createElement(t);for(const[k,v]of Object.entries(a)){if(k==='class')n.className=v;else if(k==='html')n.innerHTML=v;else n.setAttribute(k,v);}c.flat().forEach(x=>x!=null&&n.append(x));return n;};\n const num=v=>{const n=Number(v);return Number.isFinite(n)?n:null;};\n const esc=s=>String(s??'').replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]));\n const ready=()=>typeof tables==='object'&&tables&&tables.Batch&&tables.Batch.rows&&tables.Batch.rows.length;\n\n let capa=null;\n\n // ── 데이터 조회 ─────────────────────────────────────────────\n const batches=()=>tables.Batch.rows;\n const matRows=()=>tables.Material?tables.Material.rows:[];\n const qcRows=()=>tables.QC?tables.QC.rows:[];\n const byIndex=()=>{const m=new Map();batches().forEach((b,i)=>m.set(b.Batch_ID,i));return m;};\n const lotOf=(bid,mat)=>{const r=matRows().find(r=>r.Batch_ID===bid&&r.Material_ID===mat);return r?r.Lot_ID:null;};\n const qcOf=(bid,an)=>qcRows().find(r=>r.Batch_ID===bid&&r.Analyte_ID===an);\n const materials=()=>[...new Set(matRows().map(r=>r.Material_ID))].sort();\n const lotsFor=mat=>[...new Set(matRows().filter(r=>r.Material_ID===mat).map(r=>r.Lot_ID))].sort();\n const analytes=()=>[...new Set(qcRows().map(r=>r.Analyte_ID))];\n\n // 한 Batch의 한 항목을 규격과 대조해 판정한다\n function judge(bid,an){\n  const q=qcOf(bid,an); if(!q)return null;\n  const v=num(q.Value); if(v==null)return null;\n  const lsl=q.LSL===''?null:num(q.LSL), usl=q.USL===''?null:num(q.USL);\n  const oos=(lsl!=null&&v<lsl)||(usl!=null&&v>usl);\n  let margin=null;\n  if(!oos&&lsl!=null&&usl!=null&&usl>lsl) margin=Math.min(usl-v,v-lsl)/(usl-lsl);\n  else if(!oos&&usl!=null&&lsl==null) margin=null;\n  return {v,lsl,usl,oos,margin,near:margin!=null&&margin<NEAR,unit:q.Unit};\n }\n\n // ── 영향 범위 계산 ───────────────────────────────────────────\n function impact(mat,lot,an){\n  const idx=byIndex();\n  const rows=batches().filter(b=>lotOf(b.Batch_ID,mat)===lot).map(b=>{\n   const j=judge(b.Batch_ID,an);\n   return {id:b.Batch_ID,i:idx.get(b.Batch_ID),start:b.Start_TS,eq:b.Equipment_ID,\n           disp:b.Disposition,ship:b.Ship_Status||(b.Disposition==='HOLD'?'HOLD':'미기록'),shipTS:b.Ship_TS||'',j};\n  }).sort((a,b)=>a.i-b.i);\n  const oos=rows.filter(r=>r.j&&r.j.oos), near=rows.filter(r=>r.j&&!r.j.oos&&r.j.near);\n  const shipped=rows.filter(r=>r.ship==='SHIPPED');\n  const shippedRisk=shipped.filter(r=>r.j&&(r.j.oos||r.j.near));\n  return {rows,oos,near,shipped,shippedRisk};\n }\n\n // ── 효과성 검증 ─────────────────────────────────────────────\n // 조치 이후 구간에서 ① 동일 모드 이탈 0건 ② Ppk 목표 이상 ③ 관리도 이상 규칙 미발생\n function effectiveness(afterIndex,an){\n  const all=batches();\n  const win=all.slice(afterIndex+1,afterIndex+1+EFF_WINDOW)\n               .map(b=>({id:b.Batch_ID,j:judge(b.Batch_ID,an)})).filter(r=>r.j);\n  if(win.length<5) return {ok:false,reason:'검증 구간 Batch가 부족합니다 (최소 5건, 현재 '+win.length+'건)',win:win.length};\n  const vals=win.map(r=>r.j.v);\n  const mean=vals.reduce((a,b)=>a+b,0)/vals.length;\n  const sd=Math.sqrt(vals.reduce((a,b)=>a+(b-mean)**2,0)/(vals.length-1));\n  const {lsl,usl}=win[0].j;\n  let ppk=null;\n  if(sd>0){const u=usl!=null?(usl-mean)/(3*sd):Infinity,l=lsl!=null?(mean-lsl)/(3*sd):Infinity;ppk=Math.min(u,l);}\n  // 기준군(Reference_Eligible=true & RELEASED)으로 관리한계 산출\n  const ref=all.filter(b=>String(b.Reference_Eligible)==='true'&&b.Disposition==='RELEASED')\n               .map(b=>judge(b.Batch_ID,an)).filter(Boolean).map(j=>j.v);\n  let rule1=0,rule2=0;\n  if(ref.length>=20){\n   const rm=ref.reduce((a,b)=>a+b,0)/ref.length;\n   const rs=Math.sqrt(ref.reduce((a,b)=>a+(b-rm)**2,0)/(ref.length-1));\n   rule1=vals.filter(v=>Math.abs(v-rm)>3*rs).length;\n   let run=0,side=0;\n   for(const v of vals){const s=v>rm?1:v<rm?-1:0;if(s!==0&&s===side)run++;else{side=s;run=1;}if(run>=9)rule2++;}\n  }\n  const c1=win.filter(r=>r.j.oos).length===0, c2=ppk!=null&&ppk>=PPK_TARGET, c3=rule1===0&&rule2===0;\n  return {ok:c1&&c2&&c3,c1,c2,c3,n:win.length,oosN:win.filter(r=>r.j.oos).length,ppk,rule1,rule2};\n }\n\n // ── 화면 ────────────────────────────────────────────────────\n const STEPS=['OPEN','봉쇄','원인확정','조치실행','효과성검증','종결'];\n function newCapa(mat,lot,an,imp){\n  return {id:'CAPA-'+lot,mat,lot,an,step:0,\n   scope:imp.rows.length+'건 투입 · 이탈 '+imp.oos.length+' · 규격 내 주의 '+imp.near.length+' · 출하 완료 '+imp.shipped.length,\n   contain:'',cause:'',action:'',actionIndex:null,note:''};\n }\n\n function render(){\n  const panel=document.querySelector('#impactPanel'); if(!panel)return;\n  if(!ready()){panel.innerHTML='<h3>4단계 · 영향 범위 / CAPA</h3><p class=\"muted\">먼저 왼쪽에서 데이터를 불러오세요. <b>통계용 240 Batch 불러오기</b>를 누르면 바로 확인할 수 있습니다.</p>';return;}\n  const mat=panel.dataset.mat||(materials().includes('ADDITIVE')?'ADDITIVE':materials()[0]);\n  const lotList=lotsFor(mat);\n  const lot=lotList.includes(panel.dataset.lot)?panel.dataset.lot:(lotList.includes('ADDITIVE-LOT-23')?'ADDITIVE-LOT-23':lotList[0]);\n  const anList=analytes();\n  const an=anList.includes(panel.dataset.an)?panel.dataset.an:(anList.includes('pH')?'pH':anList[0]);\n  panel.dataset.mat=mat;panel.dataset.lot=lot;panel.dataset.an=an;\n  const imp=impact(mat,lot,an);\n  if(!capa||capa.lot!==lot||capa.an!==an) capa=newCapa(mat,lot,an,imp);\n\n  const opt=(list,sel)=>list.map(v=>'<option value=\"'+esc(v)+'\"'+(v===sel?' selected':'')+'>'+esc(v)+'</option>').join('');\n  const pct=m=>m==null?'—':(m*100).toFixed(1)+'%';\n  const shipLabel={SHIPPED:'출하 완료',IN_STOCK:'재고 보유',HOLD:'보류'};\n\n  const tableRows=imp.rows.map(r=>{\n   const j=r.j, cls=j&&j.oos?'oos-row':j&&j.near?'near-row':'';\n   const vcell=j?('<td class=\"num-cell '+(j.oos?'oos-cell':j.near?'near-cell':'')+'\">'+j.v.toFixed(4)+'</td>'):'<td>—</td>';\n   const risk=r.ship==='SHIPPED'&&j&&(j.oos||j.near);\n   return '<tr class=\"'+cls+'\"><td>'+esc(r.id)+'</td><td class=\"num-cell\">'+(r.i+1)+'</td><td>'+esc(r.eq)+'</td>'\n    +vcell+'<td>'+(j?(j.oos?'<b class=\"bad\">이탈</b>':j.near?'<b class=\"warn-t\">규격 내 주의</b>':'정상'):'—')+'</td>'\n    +'<td class=\"num-cell\">'+(j&&!j.oos?pct(j.margin):'—')+'</td>'\n    +'<td>'+(shipLabel[r.ship]||esc(r.ship))+(risk?' <span class=\"risk-flag\">확인 필요</span>':'')+'</td></tr>';\n  }).join('');\n\n  const eff=capa.actionIndex!=null?effectiveness(capa.actionIndex,an):null;\n  const chk=(ok,label,detail)=>'<li class=\"'+(ok?'c-ok':'c-no')+'\"><b>'+(ok?'통과':'미통과')+'</b> '+label+' <span class=\"muted\">'+detail+'</span></li>';\n\n  panel.innerHTML=\n   '<h3>4단계 · 영향 범위 / CAPA</h3>'\n   +'<p class=\"muted\">1~3단계가 원인 후보를 좁혔다면, 여기서는 <b>그 원료로 만든 Batch 전수</b>와 <b>조치 종결</b>을 다룹니다.</p>'\n   +'<div class=\"row impact-controls\">'\n     +'<label>원료 구분<select id=\"impMat\">'+opt(materials(),mat)+'</select></label>'\n     +'<label>원료 LOT<select id=\"impLot\">'+opt(lotList,lot)+'</select></label>'\n     +'<label>검사 항목<select id=\"impAn\">'+opt(anList,an)+'</select></label>'\n   +'</div>'\n   +'<div class=\"impact-cards\">'\n     +'<div class=\"ic\"><span class=\"k\">투입 Batch</span><span class=\"v\">'+imp.rows.length+'</span></div>'\n     +'<div class=\"ic ic-bad\"><span class=\"k\">규격 이탈</span><span class=\"v\">'+imp.oos.length+'</span></div>'\n     +'<div class=\"ic ic-warn\"><span class=\"k\">규격 내 주의</span><span class=\"v\">'+imp.near.length+'</span><span class=\"n\">여유 '+(NEAR*100)+'% 미만</span></div>'\n     +'<div class=\"ic\"><span class=\"k\">출하 완료</span><span class=\"v\">'+imp.shipped.length+'</span><span class=\"n\">그중 확인 필요 '+imp.shippedRisk.length+'</span></div>'\n   +'</div>'\n   +(imp.shippedRisk.length\n     ? '<div class=\"verdict v-bad\"><b>출하된 '+imp.shippedRisk.length+'건에 대한 판단이 필요합니다</b><span>'+esc(lot)+'을(를) 쓴 Batch 중 이탈이거나 규격 여유가 '+(NEAR*100)+'% 미만인데 이미 출하된 건입니다. 봉쇄 범위를 이탈 '+imp.oos.length+'건으로 한정할지, LOT 전체로 넓힐지 결정하세요.</span></div>'\n     : '<div class=\"verdict v-ok\"><b>출하된 Batch 중 추가 확인 대상 없음</b><span>이 LOT으로 만든 Batch 가운데 이탈·주의 상태로 출하된 건이 없습니다.</span></div>')\n   +'<div class=\"scroll\"><table><thead><tr><th>Batch ID</th><th>생산 순번</th><th>설비</th><th>'+esc(an)+' 값</th><th>판정</th><th>규격 여유</th><th>출하 상태</th></tr></thead><tbody>'+tableRows+'</tbody></table></div>'\n   +'<h4>CAPA · '+esc(capa.id)+'</h4>'\n   +'<ol class=\"capa-steps\">'+STEPS.map((s,i)=>'<li class=\"'+(i<capa.step?'done':i===capa.step?'cur':'')+'\">'+s+'</li>').join('')+'</ol>'\n   +'<label>영향 범위 (자동)<textarea id=\"capaScope\" rows=\"2\" readonly>'+esc(capa.scope)+'</textarea></label>'\n   +'<label>봉쇄 조치<textarea id=\"capaContain\" rows=\"2\" placeholder=\"예: '+esc(lot)+' 투입 Batch 전량 보류, 출하분 고객 통보 검토\">'+esc(capa.contain)+'</textarea></label>'\n   +'<label>근본 원인 (확정 근거)<textarea id=\"capaCause\" rows=\"2\" placeholder=\"예: 입고 CoA 재검토 및 보관 샘플 적정 재시험으로 알칼리 함량 편차 확인\">'+esc(capa.cause)+'</textarea></label>'\n   +'<label>시정·예방 조치<textarea id=\"capaAction\" rows=\"2\" placeholder=\"예: 입고검사 항목에 알칼리도 추가, 공급사 SCAR 발행\">'+esc(capa.action)+'</textarea></label>'\n   +'<label>조치 적용 시점 (이 생산 순번 이후를 검증 구간으로 본다)<input id=\"capaIdx\" type=\"number\" min=\"1\" max=\"'+batches().length+'\" value=\"'+(capa.actionIndex!=null?capa.actionIndex+1:(imp.rows.length?imp.rows[imp.rows.length-1].i+1:''))+'\"></label>'\n   +'<p><button id=\"capaVerify\" class=\"primary\">효과성 검증 실행</button> <button id=\"capaExport\">CAPA 내보내기 (JSON)</button></p>'\n   +(eff?('<div class=\"eff '+(eff.ok?'eff-ok':'eff-no')+'\">'\n      +'<b>'+(eff.ok?'효과성 검증 통과 — 종결 가능':'효과성 검증 미통과 — 종결 불가')+'</b>'\n      +(eff.reason?'<p class=\"muted\">'+esc(eff.reason)+'</p>':\n       '<ul class=\"eff-list\">'\n        +chk(eff.c1,'동일 모드 이탈 0건','검증 구간 '+eff.n+'건 중 이탈 '+eff.oosN+'건')\n        +chk(eff.c2,'Ppk '+PPK_TARGET+' 이상',(eff.ppk!=null?'Ppk '+eff.ppk.toFixed(2):'산출 불가')+' · 전체 표준편차 기준')\n        +chk(eff.c3,'관리도 이상 규칙 미발생','3σ 초과 '+eff.rule1+'건 · 연속 9점 편향 '+eff.rule2+'건')\n       +'</ul>')\n      +'</div>'):'')\n   +'<p class=\"muted\">세 조건을 모두 만족할 때만 종결로 넘어갑니다. 검증 구간은 조치 시점 이후 '+EFF_WINDOW+' Batch이며, 관리한계는 Reference_Eligible=true·RELEASED 기준군에서 산출합니다.</p>';\n\n  // 이벤트 연결\n  const bind=(id,fn)=>{const n=panel.querySelector(id);if(n)n.addEventListener('change',fn);};\n  bind('#impMat',e=>{panel.dataset.mat=e.target.value;panel.dataset.lot='';render();});\n  bind('#impLot',e=>{panel.dataset.lot=e.target.value;capa=null;render();});\n  bind('#impAn',e=>{panel.dataset.an=e.target.value;capa=null;render();});\n  ['contain','cause','action'].forEach(k=>{const n=panel.querySelector('#capa'+k[0].toUpperCase()+k.slice(1));\n   if(n)n.addEventListener('input',e=>{capa[k]=e.target.value;capa.step=Math.max(capa.step,['contain','cause','action'].indexOf(k)+1);});});\n  const verify=panel.querySelector('#capaVerify');\n  if(verify)verify.onclick=()=>{const v=Number(panel.querySelector('#capaIdx').value);\n   if(!Number.isFinite(v)||v<1){alert('조치 적용 시점을 생산 순번으로 입력하세요.');return;}\n   capa.actionIndex=v-1;capa.step=4;render();\n   const r=effectiveness(capa.actionIndex,panel.dataset.an); if(r.ok)capa.step=5;};\n  const exp=panel.querySelector('#capaExport');\n  if(exp)exp.onclick=()=>{const blob=new Blob([JSON.stringify({...capa,verifiedAt:new Date().toISOString(),effectiveness:capa.actionIndex!=null?effectiveness(capa.actionIndex,panel.dataset.an):null},null,1)],{type:'application/json'});\n   const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=capa.id+'.json';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);};\n  if(window.CMPSetStep)window.CMPSetStep(4);\n }\n\n // ── 설치 ────────────────────────────────────────────────────\n function install(){\n  if(document.querySelector('#impactOpen'))return;\n  const anchor=document.querySelector('#report'); if(!anchor)return;\n  const btn=el('button',{id:'impactOpen'}); btn.textContent='4단계 · 영향 범위 / CAPA';\n  anchor.parentElement.append(btn);\n  const panel=el('section',{id:'impactPanel'}); panel.hidden=true;\n  (anchor.closest('.grid>div')||document.body).append(panel);\n  btn.onclick=()=>{panel.hidden=!panel.hidden; if(!panel.hidden){render();panel.scrollIntoView({behavior:'smooth',block:'start'});}};\n }\n if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',install); else install();\n window.CMPImpact={render,impact,effectiveness,judge};\n})();\n</script><script>// 가독성 레이어 — 기존 화면 구조는 그대로 두고 표시 방식만 보강한다.\n// 1) 한글 본문 가독성(폰트 스택·행간·자간)  2) 숫자 정렬(tabular-nums)\n// 3) 규격 이탈 값 시각 강조  4) 보고서 최상단 결론 배너  5) 단계 진행 표시\n// 6) 좌측 패널 접기  7) 다크 모드\n(function(){\n const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];\n\n // ── 숫자 셀 정렬: 숫자로만 이루어진 셀을 우측 정렬 + 등폭 숫자\n function alignNumbers(scope){\n  for(const td of scope.querySelectorAll('td')){\n   const t=td.textContent.trim();\n   if(t && /^[-+]?\\d[\\d,]*(\\.\\d+)?$/.test(t)) td.classList.add('num-cell');\n  }\n }\n\n // ── 규격 이탈 강조: '현재 값'과 '규격 하한 / 상한'을 가진 표를 찾아 비교\n function markOOS(scope){\n  for(const table of scope.querySelectorAll('table')){\n   try{\n    const heads=[...table.querySelectorAll('thead th, tr:first-child th')].map(th=>th.textContent.replace(/\\s+/g,''));\n    const vi=heads.findIndex(h=>h.includes('현재값'));\n    const si=heads.findIndex(h=>h.includes('규격하한')||h.includes('하한/상한'));\n    if(vi<0||si<0) continue;\n    for(const tr of table.querySelectorAll('tbody tr, tr')){\n     const tds=tr.querySelectorAll('td'); if(tds.length<=Math.max(vi,si)) continue;\n     const v=Number(tds[vi].textContent.replace(/,/g,'').trim());\n     const m=tds[si].textContent.split('/').map(x=>x.trim());\n     if(!Number.isFinite(v)||m.length<2) continue;\n     const lsl=m[0]===''||m[0]==='-'?null:Number(m[0]), usl=m[1]===''||m[1]==='-'?null:Number(m[1]);\n     const low=lsl!=null&&Number.isFinite(lsl)&&v<lsl, high=usl!=null&&Number.isFinite(usl)&&v>usl;\n     if(low||high){ tr.classList.add('oos-row'); tds[vi].classList.add('oos-cell'); tds[vi].setAttribute('title',(high?'규격 상한 초과':'규격 하한 미달')); }\n     else if(usl!=null&&lsl!=null&&Number.isFinite(usl)&&Number.isFinite(lsl)){\n      const band=usl-lsl, margin=Math.min(usl-v,v-lsl);\n      if(band>0 && margin/band<0.05){ tr.classList.add('near-row'); tds[vi].classList.add('near-cell'); tds[vi].setAttribute('title','규격 내이지만 여유 5% 미만'); }\n     }\n    }\n   }catch(e){/* 표 구조가 다르면 조용히 건너뛴다 */}\n  }\n }\n\n // ── 결론 배너: 보고서 상단에 한 줄 판정을 올린다\n function verdictBanner(out){\n  const h=out.querySelector('h2,h3'); if(!h) return;\n  const oos=out.querySelectorAll('.oos-row').length, near=out.querySelectorAll('.near-row').length;\n  const old=out.querySelector('.verdict'); if(old) old.remove();\n  const el=document.createElement('div');\n  el.className='verdict '+(oos?'v-bad':near?'v-warn':'v-ok');\n  el.innerHTML = oos\n   ? '<b>규격 이탈 '+oos+'건</b><span>품질 담당자 검토 대상입니다. 아래 표에서 붉게 표시된 항목을 확인하세요.</span>'\n   : near\n   ? '<b>규격 내 · 주의 '+near+'건</b><span>이탈은 아니지만 규격 여유가 5% 미만인 항목이 있습니다.</span>'\n   : '<b>규격 내 · 정상</b><span>검사 항목 전체가 규격 안에 있습니다.</span>';\n  h.after(el);\n }\n\n // ── 단계 진행 표시\n function stepBar(){\n  const anchor=$('#report'); if(!anchor||$('#stepBar')) return;\n  const bar=document.createElement('div'); bar.id='stepBar';\n  bar.innerHTML=['1 · Batch 보고서','2 · LOT 통계 분석','3 · RCA / 검증','4 · 영향 범위 / CAPA']\n   .map((t,i)=>'<span data-step=\"'+(i+1)+'\">'+t+'</span>').join('');\n  anchor.closest('section').prepend(bar);\n }\n function setStep(n){ $$('#stepBar span').forEach(s=>s.classList.toggle('on',Number(s.dataset.step)<=n)); }\n window.CMPSetStep=setStep;\n\n // ── 좌측 패널 접기 (한 번 쓰고 마는 기능이 화면을 계속 차지하지 않도록)\n function collapsibleSidebar(){\n  const col=document.querySelector('.grid>div:first-child'); if(!col||col.dataset.collapsible) return;\n  col.dataset.collapsible='1';\n  const btn=document.createElement('button'); btn.id='sideToggle'; btn.type='button';\n  btn.textContent='데이터 · 조회 범위 접기';\n  btn.onclick=()=>{ const hid=col.classList.toggle('side-collapsed');\n   btn.textContent=hid?'데이터 · 조회 범위 펼치기':'데이터 · 조회 범위 접기';\n   document.querySelector('.grid').classList.toggle('grid-wide',hid); };\n  col.prepend(btn);\n }\n\n // ── 보고서가 다시 그려질 때마다 위 처리를 적용\n function enhance(){\n  const out=$('#out'); if(!out) return;\n  alignNumbers(out); markOOS(out); verdictBanner(out);\n  if(out.textContent.trim()) setStep(1);\n }\n const out=$('#out');\n if(out) new MutationObserver(()=>{ clearTimeout(enhance._t); enhance._t=setTimeout(enhance,60); }).observe(out,{childList:true,subtree:true});\n const stats=$('#statsPanel');\n if(stats) new MutationObserver(()=>{ clearTimeout(enhance._s); enhance._s=setTimeout(()=>{alignNumbers(stats);markOOS(stats);},80); }).observe(stats,{childList:true,subtree:true});\n\n document.addEventListener('DOMContentLoaded',()=>{stepBar();collapsibleSidebar();});\n stepBar(); collapsibleSidebar(); enhance();\n $$('#statisticsOpen').forEach(b=>b.addEventListener('click',()=>setStep(2)));\n})();\n</script><script>(function(){\nconst panel=document.createElement('section');panel.id='readiness';panel.innerHTML=`<details><summary><b>운영 준비 · 검토 이력 백업/복원 · 자체 점검</b></summary>\n<p>기본 시연: 설비별 LOT 순차 생산, 원료 LOT 1개당 생산 LOT 6개 연결, 공장 전체 07–19시 / 19–다음 날 07시 교대. 원료 LOT는 드럼 용량을 의미하지 않습니다. 240 Batch 버튼으로 적용된 예시를 불러오세요.</p><p>단위: pH(무차원), 고형분 wt%, 점도 mPa·s, D50/D90 nm, LPC 개/mL, 제타 전위 mV, Fe µg/kg, 온도 °C, 차압 kPa, 회전수 rpm, 시간 min.</p><p>빈 QC 값·None은 결측으로 처리하고 계산에서 제외합니다. 미측정인지 미기록인지는 자동 추정하지 않습니다. 필수 ID·시각·공정값 누락은 해당 위치를 경고합니다. 정상 데이터의 평균·표준편차는 출하 규격을 대신하지 않습니다.</p>\n<table><tr><th>지금 준비할 정보</th><th>담당자에게 나중에 확인할 정보</th></tr><tr><td>6개 역할별 열 이름과 단위, 날짜 표기·시간대, 익명 처리한 소량 예시, Batch/설비 연결 방법</td><td>제품·처방·시험법별 LSL/USL, 적용 시작일과 개정, 최종 시험 선택 규칙, 정상 비교군 선정 조건</td></tr><tr><td>체크시트는 공장 전체 교대당 1회: 주/야 시작 시각과 적용 구간</td><td>공정 목표·상한, 실제 OCAP 승인 절차, 검토 담당자</td></tr></table>\n<p>규격 미확정: 능력 충족 여부·출하 적합성은 보류합니다. 공급사 일반 자료의 수치를 현장 규격으로 자동 적용하지 마세요.</p>\n<button id='historyBackup'>검토 이력 백업</button> <button id='historyRestore'>검토 이력 복원</button><input id='historyFile' type='file' accept='.json' hidden> <button id='historyList'>저장 이력 보기</button> <button id='selfCheck'>계산 자체 점검</button>\n<p>백업 범위: 저장한 검토 기록과 그 안의 분석 근거. 현재 미저장 입력·전체 CSV·보고서 파일은 포함하지 않습니다. 원본 CSV는 별도 보관하세요. 복원은 기존 기록에 병합하며 동일 ID의 다른 내용은 거부합니다. 백업에는 원본 식별정보가 포함될 수 있습니다.</p><p id='readinessStatus' role='status'></p><div id='historyView'></div></details>`;\ndocument.querySelector('.grid>div').append(panel);\nconst status=s=>document.querySelector('#readinessStatus').textContent=s;\nconst digest=async s=>Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',new TextEncoder().encode(s)))).map(x=>x.toString(16).padStart(2,'0')).join('');\nfunction validate(rows){if(!Array.isArray(rows)||rows.length>10000)throw Error('이력 배열 또는 기록 수가 잘못되었습니다.');const ids=new Set();for(const e of rows){if(e?.format!=='CMP-REVIEW-1'||typeof e.id!=='string'||!e.id||ids.has(e.id)||typeof e.bid!=='string'||!Number.isFinite(Date.parse(e.saved))||!e.user||!e.report||!Array.isArray(e.standards))throw Error('검토 기록 형식 또는 중복 ID 오류');ids.add(e.id);}}\nasync function restore(p){if(p?.format!=='CMP-REVIEW-BACKUP-1'||typeof p.payload!=='string'||await digest(p.payload)!==p.sha256)throw Error('백업 형식 또는 손상 검사 실패');const rows=JSON.parse(p.payload);validate(rows);return CMPReview.mergeCases(rows);}\ndocument.querySelector('#historyBackup').onclick=async()=>{try{const payload=JSON.stringify(CMPReview.getCases()),p={format:'CMP-REVIEW-BACKUP-1',created:new Date().toISOString(),payload,sha256:await digest(payload)},a=document.createElement('a'),url=URL.createObjectURL(new Blob([JSON.stringify(p)],{type:'application/json'}));a.href=url;a.download='CMP_Review_Backup_'+new Date().toISOString().replaceAll(':','-')+'.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),10000);status('백업 다운로드를 요청했습니다. 체크섬은 손상 확인용이며 작성자 인증은 아닙니다.');}catch(e){status(e.message);}};\ndocument.querySelector('#historyRestore').onclick=()=>document.querySelector('#historyFile').click();\ndocument.querySelector('#historyFile').onchange=async e=>{try{const f=e.target.files[0];if(!f)return;if(f.size>50*1024*1024)throw Error('50 MB 이하 백업만 복원할 수 있습니다.');status('복원 완료 · 총 '+await restore(JSON.parse(await f.text()))+'건. 현재 분석 결과는 다시 조회하세요.');}catch(err){status('복원 실패: '+err.message);}finally{e.target.value='';}};\ndocument.querySelector('#historyList').onclick=()=>{const rows=CMPReview.getCases();document.querySelector('#historyView').innerHTML=grid(['저장 시각','Batch','담당자','상태','결과'],rows.map(e=>[e.saved,e.bid,e.user.owner,e.user.state,e.user.result]));status(rows.length+'건 · 과거 기록은 변경하지 않고 후속 검토를 새 기록으로 저장합니다. 브라우저 기록은 감사용 변경 방지 저장소가 아닙니다.');};\ndocument.querySelector('#selfCheck').onclick=()=>{try{const s=CMPStats.sd([1,2,3,4,5]),m=CMPStats.mean([1,2,3,4,5]);if(Math.abs(s-Math.sqrt(2.5))>1e-12||m!==3)throw Error('기준값 불일치');status('자체 점검 통과: 평균 3, 표본 표준편차 √2.5. 전체 회귀 검증 결과와 우선 검증 계획은 동봉 안내서를 확인하세요.');}catch(e){status('자체 점검 실패: '+e.message);}};\nwindow.CMPReadiness={restore,validate,digest};\n})();\n</script>"}